#Область ШаблоныИмен

// Возвращает сформированное имя по шаблону
//
// Параметры:
//	ИсходныйШаблон - Строка - Шаблон с тегами %ТИП% и %ОПЕРАЦИЯ%.
//	ИмяТипа - Строка - Имя типа данных.
//	Операция - Булево - Действие системы-владельца: send или receive.
//
// Возвращаемое значение:
//	Строка - Сформированное имя.
Функция ИмяПоШаблону(Знач ИсходныйШаблон, Знач ИмяТипа, Знач Операция = "")
	
	Если ПустаяСтрока(ИсходныйШаблон) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан шаблон имени.'");
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяТипа) Тогда
		ВызватьИсключение НСтр("ru = 'Не задано имя типа данных.'");
	КонецЕсли;
	
	ЧастиШаблона = РазложитьШаблон(ИсходныйШаблон);
	ЧастиТипа = РазложитьИмяТипаВМассивСлов(ИмяТипа);
	
	Результат = Новый Массив;
	
	Для Каждого Шаблон Из ЧастиШаблона Цикл
		
		ТШаблон = ТипЗнч(Шаблон);
		Если ТШаблон = Тип("Строка") Тогда
			Результат.Добавить(Шаблон);
			
		ИначеЕсли ТШаблон = Тип("Структура") Тогда
			Значение = "";
			Если НРег(Шаблон.Ключ) = "тип" Тогда
				Значение = Новый Массив;
				РегистрСлова = Шаблон.РегистрПервогоСлова;
				Для Каждого Часть Из ЧастиТипа Цикл
					Значение.Добавить(СтрФормат(Часть, РегистрСлова));
					РегистрСлова = Шаблон.РегистрСледующихСлов;
				КонецЦикла;
				Результат.Добавить(СтрСоединить(Значение, Шаблон.Разделитель));
				
			ИначеЕсли НРег(Шаблон.Ключ) = "операция" Тогда
				Результат.Добавить(?(ПустаяСтрока(Шаблон.РегистрПервогоСлова), Операция,
					СтрФормат(Операция, Шаблон.РегистрПервогоСлова)));
				
			КонецЕсли;
			
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрСоединить(Результат);
	
КонецФункции

// Возвращает массив частей шаблона
// 
// Параметры:
//	ИсходныйШаблон - Строка - Исходный шаблон
// 
// Возвращаемое значение:
//	Массив Из Строка, Структура - Части шаблона:
//		* Ключ - Строка - Имя тега
//		* РегистрПервогоСлова - Строка - Регистр первого слова
//		* Разделитель - Строка - Разделитель
//		* РегистрСледующихСлов - Строка - Регистр следующих слов
Функция РазложитьШаблон(Знач ИсходныйШаблон)
	
	Результат = Новый Массив;
	
	Вхождения = СтрНайтиВсеПоРегулярномуВыражению(ИсходныйШаблон, "%(ТИП|ОПЕРАЦИЯ)(:(аа)([-_.]?)(аа)?)?%", Истина);
	Если Вхождения.Количество() = 0 Тогда
		Результат.Добавить(ИсходныйШаблон);
		Возврат Результат;
	КонецЕсли;
	
	ТекущаяПозиция = 1;
	
	Для Каждого Вхождение Из Вхождения Цикл
		
		ДлинаЗначения = Вхождение.НачальнаяПозиция - ТекущаяПозиция;
		
		Если ДлинаЗначения > 0 Тогда
			Результат.Добавить(Сред(ИсходныйШаблон, ТекущаяПозиция, ДлинаЗначения));
		КонецЕсли;
		
		Группы = Вхождение.ПолучитьГруппы();
		
		Выражение = Новый Структура;
		Выражение.Вставить("Ключ", Группы[0].Значение);
		Если Не (Группы[1] = Неопределено Или ПустаяСтрока(Группы[1].Значение)) Тогда
			Выражение.Вставить("РегистрПервогоСлова", Группы[2].Значение);
			Выражение.Вставить("Разделитель", Группы[3].Значение);
			Выражение.Вставить("РегистрСледующихСлов", Группы[4].Значение);
		КонецЕсли;
		Результат.Добавить(Выражение);
		
		ТекущаяПозиция = Вхождение.НачальнаяПозиция + Вхождение.Длина;
		
	КонецЦикла;
	
	// Добавляем текст после последнего тега.
	Если ТекущаяПозиция <= СтрДлина(ИсходныйШаблон) Тогда
		Результат.Добавить(Сред(ИсходныйШаблон, ТекущаяПозиция));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разделяет имя типа данных на слова.
//
// Параметры:
//	ИмяТипа - Строка - Имя типа данных.
//
// Возвращаемое значение:
//	Массив из Строка - Слова имени типа данных.
//
Функция РазложитьИмяТипаВМассивСлов(Знач ИмяТипа)
	
	Результат = Новый Массив;
	
	Если ПустаяСтрока(ИмяТипа) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Слово = "";
	ДлинаИмени = СтрДлина(ИмяТипа);
	
	Для Позиция = 1 По ДлинаИмени Цикл
		
		Символ = Сред(ИмяТипа, Позиция, 1);
		
		Если СтрНайти("-_ .", Символ) > 0 Тогда
			
			Если Не ПустаяСтрока(Слово) Тогда
				Результат.Добавить(Слово);
				Слово = "";
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		НачалоНовогоСлова = Ложь;
		
		Если Не ПустаяСтрока(Слово) Тогда
			
			ПредыдущийСимвол = Сред(ИмяТипа, Позиция - 1, 1);
			
			ТекущаяПрописная = Символ = ВРег(Символ)
				И Символ <> НРег(Символ);
			
			ПредыдущаяСтрочная = ПредыдущийСимвол = НРег(ПредыдущийСимвол)
				И ПредыдущийСимвол <> ВРег(ПредыдущийСимвол);
			
			НачалоНовогоСлова = ТекущаяПрописная
				И ПредыдущаяСтрочная;
			
			Если Не НачалоНовогоСлова
				И ТекущаяПрописная
				И Позиция < ДлинаИмени Тогда
				
				СледующийСимвол = Сред(ИмяТипа, Позиция + 1, 1);
				
				ПредыдущаяПрописная = ПредыдущийСимвол = ВРег(ПредыдущийСимвол)
					И ПредыдущийСимвол <> НРег(ПредыдущийСимвол);
				
				СледующаяСтрочная = СледующийСимвол = НРег(СледующийСимвол)
					И СледующийСимвол <> ВРег(СледующийСимвол);
				
				НачалоНовогоСлова = ПредыдущаяПрописная
					И СледующаяСтрочная;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НачалоНовогоСлова Тогда
			Результат.Добавить(Слово);
			Слово = "";
		КонецЕсли;
		
		Слово = Слово + Символ;
		
	КонецЦикла;
	
	Если Не ПустаяСтрока(Слово) Тогда
		Результат.Добавить(Слово);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает строку преобразованную в указанный регистр слова
// 
// Параметры:
//	Значение - Строка - Значение
//	РегистрСлова - Строка - Регистр слова, доступные значения: АА, аа, Аа, аА
// 
// Возвращаемое значение:
//	Строка - Преобразованная строка
Функция СтрФормат(Значение, РегистрСлова)
	
	Если ПустаяСтрока(Значение) Тогда
		Возврат Значение;
		
	ИначеЕсли РегистрСлова = "АА" Тогда
		Возврат ВРег(Значение);
		
	ИначеЕсли РегистрСлова = "аа" Тогда
		Возврат НРег(Значение);
		
	ИначеЕсли РегистрСлова = "Аа" Тогда
		Возврат ТРег(Значение);
		
	ИначеЕсли РегистрСлова = "аА" Тогда
		Возврат НРег(Лев(Значение, 1)) + ВРег(Сред(Значение, 2));
		
	Иначе
		Возврат Значение;
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецОбласти

