//				x-enumNames:
//					- Не определено
//					- Хорошее
//					- Плохое
	
	Для Каждого Элемент Из Список Цикл
		
		Перечисление = ИсторияПеречисление(История, Элемент.Значение);
		
		ДобавитьСтроку(ТДок, 2, Перечисление.Наименование);
		ДобавитьСтроку(ТДок, 3, "type", ТипыЗначений.Получить(Перечисление.ТипЗначения.Ссылка));
		ДобавитьСтроку(ТДок, 3, "enum");
		Для Каждого Значение Из Перечисление.Значения Цикл
			ДобавитьСтроку(ТДок, 4, , Значение.Значение);
		КонецЦикла;
		Если Перечисление.Значения.Количество() > 0 И Не ПустаяСтрока(Перечисление.Значения[0].Представление) Тогда
			ДобавитьСтроку(ТДок, 3, "x-enumNames");
			Для Каждого Значение Из Перечисление.Значения Цикл
				ДобавитьСтроку(ТДок, 4, , Значение.Представление);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Доступные типы значений спецификации
// 
// Возвращаемое значение:
//	Соответствие Из КлючИЗначение - Доступные типы значений:
//		* Ключ - СправочникСсылка.кфкТипыЗначенийСпецификации - Тип значения
//		* Значение - Строка - Код типа значения
Функция ДоступныеТипыЗначений()
	
	Результат = Новый Соответствие;
	
	Выборка = Справочники.кфкТипыЗначенийСпецификации.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.Код);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает подчиненные элементы типов данных
// 
// Параметры:
//	Спецификация - СправочникСсылка.кфкСпецификации - Спецификация
// 
// Возвращаемое значение:
//	Соответствие Из КлючИЗначение - Подчинные элементы:
//		* Ключ - СправочникСсылка.кфкТипыДанныхСпецификации - Родитель
//		* Значение - Массив Из СправочникСсылка.кфкТипыДанныхСпецификации - Подчиненные элементы
Функция ПодчинныеЭлементыТиповДанных(Спецификация)
	
	Результат = Новый Соответствие;
	
	Выборка = Справочники.кфкТипыДанныхСпецификации.Выбрать(, Спецификация);
	Пока Выборка.Следующий() Цикл
		
		Элементы = Результат.Получить(Выборка.Родитель);
		Если Элементы = Неопределено Тогда
			Элементы = Новый Массив;
			Результат.Вставить(Выборка.Родитель, Элементы);
		КонецЕсли;
		
		Элементы.Добавить(Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

