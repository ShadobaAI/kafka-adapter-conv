
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает JSON с описаниями объектов, свойств и табличных частей выбранного релиза.
// Параметры:
//  Релиз - СправочникСсылка.Релизы
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - дерево метаданных с UUID в качестве ключей.
Функция ОписаниеМетаданных(Релиз) Экспорт

	РезультатЗапроса = ДанныеМетаданных(Релиз);

	Объекты = РезультатЗапроса[0].Выгрузить();
	Свойства = РезультатЗапроса[1].Выгрузить();
	ТабличныеЧасти = РезультатЗапроса[2].Выгрузить();

	Свойства.Индексы.Добавить("Владелец,Родитель");
	ТабличныеЧасти.Индексы.Добавить("Владелец");

	Возврат ОписанияОбъектов(Объекты, Свойства, ТабличныеЧасти);

КонецФункции

// Заполняет английские имена объектов, свойств и полей табличных частей по UUID.
// Проверяет русские имена и принадлежность свойств перед записью каждого элемента.
// Пустые английские имена не изменяют сохраненные значения.
//
// Параметры:
//  Описание - см. ОписаниеМетаданных
Процедура ЗагрузитьИменаСпецификации(Описание) Экспорт

	Для Каждого КлючЗначениеОбъекта Из Описание Цикл

		СсылкаОбъекта = Справочники.Объекты.ПолучитьСсылку(
			Новый УникальныйИдентификатор(КлючЗначениеОбъекта.Ключ));
		Объект = СсылкаОбъекта.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Объект %1 не найден.'"), КлючЗначениеОбъекта.Ключ);
		КонецЕсли;
		
		ОписаниеОбъекта = КлючЗначениеОбъекта.Значение; // Структура, Соответствие
		Если Объект.Имя <> ОписаниеОбъекта["ИмяRU"] Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Имя объекта %1 не совпадает с загруженным.'"), КлючЗначениеОбъекта.Ключ);
		КонецЕсли;
		
		ЗаполнитьИмяEN(Объект, ОписаниеОбъекта["ИмяEN"]);
		ЗагрузитьИменаСвойств(Объект.Ссылка, Справочники.Свойства.ПустаяСсылка(), ОписаниеОбъекта["Свойства"]);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Загружает имена свойств объекта и вложенных полей табличных частей.
// Вложенные поля передаются в необязательном ключе Свойства описания элемента.
//
// Параметры:
//  Владелец - СправочникСсылка.Объекты
//  Родитель - СправочникСсылка.Свойства - пустая ссылка для свойств объекта.
//  Описание - см. ОписанияСвойств
Процедура ЗагрузитьИменаСвойств(Знач Владелец, Знач Родитель, Знач Описание)

	Для Каждого КлючЗначениеСвойства Из Описание Цикл

		СсылкаСвойства = Справочники.Свойства.ПолучитьСсылку(
			Новый УникальныйИдентификатор(КлючЗначениеСвойства.Ключ));
		Свойство = СсылкаСвойства.ПолучитьОбъект();
		Если Свойство = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Свойство %1 не найдено.'"), КлючЗначениеСвойства.Ключ);
		КонецЕсли;
		Если Свойство.Владелец <> Владелец Или Свойство.Родитель <> Родитель Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Свойство %1 не принадлежит указанному объекту или группе свойств.'"),
				КлючЗначениеСвойства.Ключ);
		КонецЕсли;
		
		ОписаниеСвойства = КлючЗначениеСвойства.Значение; // Структура, Соответствие
		Если Свойство.Наименование <> ОписаниеСвойства["ИмяRU"] Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Имя свойства %1 не совпадает с загруженным.'"), КлючЗначениеСвойства.Ключ);
		КонецЕсли;

		ЗаполнитьИмяEN(Свойство, ОписаниеСвойства["ИмяEN"]);

		ВложенныеСвойства = Неопределено; // Соответствие
		Если ТипЗнч(ОписаниеСвойства) = Тип("Соответствие") Тогда
			ВложенныеСвойства = ОписаниеСвойства.Получить("Свойства");
		Иначе
			ОписаниеСвойства.Свойство("Свойства", ВложенныеСвойства);
		КонецЕсли;
		Если ВложенныеСвойства <> Неопределено Тогда
			ЗагрузитьИменаСвойств(Владелец, Свойство.Ссылка, ВложенныеСвойства);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Записывает измененное непустое английское имя элемента.
//
// Параметры:
//  Элемент - СправочникОбъект.Объекты, СправочникОбъект.Свойства
//  ИмяEN - Строка
Процедура ЗаполнитьИмяEN(Элемент, Знач ИмяEN)
	
	Если ПустаяСтрока(ИмяEN) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Пустое английское имя свойства %1.'"), Элемент.Наименование);
	ИначеЕсли Элемент.кфкИмяEN <> ИмяEN Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Изменено английское имя свойства %1.'"), Элемент.Наименование);
	ИначеЕсли Элемент.кфкИмяEN = ИмяEN Тогда
		Возврат;
	КонецЕсли;
	
	Элемент.кфкИмяEN = ИмяEN;
	Элемент.Записать();

КонецПроцедуры

// Возвращает результаты пакетного запроса по объектам, свойствам и табличным частям релиза.
// Параметры:
//  Релиз - СправочникСсылка.Релизы
// Возвращаемое значение:
//  Массив из РезультатЗапроса - объекты, свойства и табличные части в исходном порядке.
Функция ДанныеМетаданных(Знач Релиз)

	// Получаем объекты, свойства и табличные части одним пакетом запросов.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Имя КАК ИмяRU,
		|	Т.кфкИмяEN КАК ИмяEN,
		|	Т.Тип КАК Тип
		|ИЗ
		|	Справочник.Объекты КАК Т
		|ГДЕ
		|	Т.Владелец = &Владелец
		|	И Т.Тип В (&СсылочныеТипыОбъектов)
		|	И Т.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Свойства.Ссылка КАК Ссылка,
		|	Свойства.Владелец КАК Владелец,
		|	Свойства.Родитель КАК Родитель,
		|	Свойства.Наименование КАК ИмяRU,
		|	ВЫБОР
		|		КОГДА Свойства.Наименование = """"""""
		|			ТОГДА ЕСТЬNULL(ШаблоныИмен.Значение, """")
		|		ИНАЧЕ Свойства.Наименование
		|	КОНЕЦ КАК ИмяEN,
		|	ВЫБОР
		|		КОГДА ТОбъекты.Тип В (&СсылочныеТипыОбъектов)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.УникальныйИдентификатор)
		|		ИНАЧЕ ТОбъекты.Тип
		|	КОНЕЦ КАК Тип
		|ИЗ
		|	Справочник.Свойства КАК Свойства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Объекты КАК Объекты
		|		ПО Свойства.Владелец = Объекты.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Свойства.Типы КАК СвойстваТипы
		|		ПО Свойства.Ссылка = СвойстваТипы.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Объекты КАК ТОбъекты
		|		ПО СвойстваТипы.Тип = ТОбъекты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.кфкШаблоныИменПолейСпецификации КАК ШаблоныИмен
		|		ПО Свойства.Наименование = ШаблоныИмен.Ключ
		|ГДЕ
		|	Объекты.Владелец = &Владелец
		|	И Свойства.ЭтоГруппа = ЛОЖЬ
		|	И Свойства.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Свойства.Ссылка КАК Ссылка,
		|	Свойства.Владелец КАК Владелец,
		|	Свойства.Наименование КАК ИмяRU,
		|	ВЫБОР
		|		КОГДА Свойства.Наименование = """"""""
		|			ТОГДА ЕСТЬNULL(ШаблоныИмен.Значение, """")
		|		ИНАЧЕ Свойства.Наименование
		|	КОНЕЦ КАК ИмяEN
		|ИЗ
		|	Справочник.Свойства КАК Свойства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Объекты КАК Объекты
		|		ПО Свойства.Владелец = Объекты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.кфкШаблоныИменПолейСпецификации КАК ШаблоныИмен
		|		ПО Свойства.Наименование = ШаблоныИмен.Ключ
		|ГДЕ
		|	Объекты.Владелец = &Владелец
		|	И Свойства.ЭтоГруппа = ИСТИНА
		|	И Свойства.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Владелец", Релиз);
	Запрос.УстановитьПараметр("СсылочныеТипыОбъектов", Перечисления.ТипыОбъектов.кфкСсылочныеТипы());
	РезультатЗапроса = Запрос.ВыполнитьПакет();

	Возврат РезультатЗапроса;

КонецФункции

// Возвращает дерево описаний объектов, их свойств и табличных частей.
// Параметры:
//  Объекты - ТаблицаЗначений:
//   * Ссылка - СправочникСсылка.Объекты
//   * ИмяRU - Строка
//   * ИмяEN - Строка
//   * Тип - ПеречислениеСсылка.ТипыОбъектов
//  Свойства - ТаблицаЗначений:
//   * Ссылка - СправочникСсылка.Свойства
//   * Владелец - СправочникСсылка.Объекты
//   * Родитель - СправочникСсылка.Свойства
//   * ИмяRU - Строка
//   * ИмяEN - Строка
//   * Тип - ПеречислениеСсылка.ТипыОбъектов
//  ТабличныеЧасти - ТаблицаЗначений:
//   * Ссылка - СправочникСсылка.Свойства
//   * Владелец - СправочникСсылка.Объекты
//   * ИмяRU - Строка
//   * ИмяEN - Строка
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - UUID объекта.
//   * Значение - Структура:
//    ** ИмяRU - Строка
//    ** ИмяEN - Строка
//    ** Тип - Строка
//    ** Свойства - Соответствие из КлючИЗначение:
//     *** Ключ - Строка - UUID свойства или табличной части.
//     *** Значение - Структура:
//      **** ИмяRU - Строка
//      **** ИмяEN - Строка
//      **** Тип - Строка - присутствует у свойства.
//      **** Свойства - Соответствие из КлючИЗначение - присутствует у табличной части:
//       ***** Ключ - Строка - UUID свойства табличной части.
//       ***** Значение - Структура:
//        ****** ИмяRU - Строка
//        ****** ИмяEN - Строка
//        ****** Тип - Строка
Функция ОписанияОбъектов(Знач Объекты, Знач Свойства, Знач ТабличныеЧасти)

	Результат = Новый Соответствие;
	Для Каждого Объект Из Объекты Цикл
		
		СвойстваОбъекта = ОписанияСвойств(Объект.Ссылка, Справочники.Свойства.ПустаяСсылка(), Свойства);

		ОтборТабличныхЧастей = Новый Структура("Владелец", Объект.Ссылка);
		Для Каждого ТЧ Из ТабличныеЧасти.НайтиСтроки(ОтборТабличныхЧастей) Цикл
			
			СвойстваТЧ = ОписанияСвойств(Объект.Ссылка, ТЧ.Ссылка, Свойства);
			
			Если СвойстваТЧ.Количество() = 0 И Не ПустаяСтрока(ТЧ.ИмяEN) Тогда
				Продолжить;
			КонецЕсли;
			
			ОписаниеТЧ = Новый Структура;
			ОписаниеТЧ.Вставить("ИмяRU", ТЧ.ИмяRU);
			ОписаниеТЧ.Вставить("ИмяEN", ТЧ.ИмяEN);
			ОписаниеТЧ.Вставить("Тип", "ТабличнаяЧасть");
			ОписаниеТЧ.Вставить("Свойства", СвойстваТЧ);
			СвойстваОбъекта.Вставить(XMLСтрока(ТЧ.Ссылка), ОписаниеТЧ);
			
		КонецЦикла;
		
		Если СвойстваОбъекта.Количество() = 0 И Не ПустаяСтрока(Объект.ИмяEN) Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеОбъекта = Новый Структура;
		ОписаниеОбъекта.Вставить("ИмяRU", Объект.ИмяRU);
		ОписаниеОбъекта.Вставить("ИмяEN", Объект.ИмяEN);
		ОписаниеОбъекта.Вставить("Тип", XMLСтрока(Объект.Тип));
		ОписаниеОбъекта.Вставить("Свойства", СвойстваОбъекта);
		Результат.Вставить(XMLСтрока(Объект.Ссылка), ОписаниеОбъекта);
		
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает описания свойств объекта или табличной части, сгруппированные по UUID.
// Параметры:
//  Владелец - СправочникСсылка.Объекты
//  Родитель - СправочникСсылка.Свойства
//  Свойства - ТаблицаЗначений:
//   * Ссылка - СправочникСсылка.Свойства
//   * Владелец - СправочникСсылка.Объекты
//   * Родитель - СправочникСсылка.Свойства
//   * ИмяRU - Строка
//   * ИмяEN - Строка
//   * Тип - ПеречислениеСсылка.ТипыОбъектов
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - UUID свойства.
//   * Значение - Структура:
//    ** ИмяRU - Строка
//    ** ИмяEN - Строка
//    ** Тип - Строка
Функция ОписанияСвойств(Знач Владелец, Знач Родитель, Знач Свойства)

	Результат = Новый Соответствие;
	Отбор = Новый Структура("Владелец, Родитель", Владелец, Родитель);

	Для Каждого Свойство Из Свойства.НайтиСтроки(Отбор) Цикл
		
		Если Не ПустаяСтрока(Свойство.ИмяEN) Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеСвойства = Новый Структура;
		ОписаниеСвойства.Вставить("ИмяRU", Свойство.ИмяRU);
		ОписаниеСвойства.Вставить("ИмяEN", Свойство.ИмяEN);
		ОписаниеСвойства.Вставить("Тип", XMLСтрока(Свойство.Тип));
		Результат.Вставить(XMLСтрока(Свойство.Ссылка), ОписаниеСвойства);
		
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
