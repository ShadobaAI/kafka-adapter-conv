
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура кфкПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Элемент = Элементы.Вставить("кфкИмяEN", Тип("ПолеФормы"), Элементы.ГруппаИдентификация, Элементы.Синоним);
	Элемент.ПутьКДанным = "Объект.кфкИмяEN";
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	
	Элемент = Элементы.Вставить("кфкПроверкаЗаполнения", Тип("ПолеФормы"), , Элементы.ГруппаДополнительнаяИнформация);
	Элемент.ПутьКДанным = "Объект.кфкПроверкаЗаполнения";
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	
КонецПроцедуры

