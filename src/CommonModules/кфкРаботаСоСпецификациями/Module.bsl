#Область ПрограммныйИнтерфейс

#Область ДанныеВерсий

// Возвращает форматонезависимые данные зафиксированной версии спецификации.
//
// Параметры:
//	ВерсияСпецификации - ДокументСсылка.кфкВерсияСпецификации - Проведенная версия спецификации.
//
// Возвращаемое значение:
//	Структура - Данные версии:
//		* Версия - Структура - Номера и строковое представление версии.
//		* Автор - Структура - Автор и дата версии.
//		* История - Структура - Снимки объектов спецификации.
Функция ПолучитьДанныеВерсии(ВерсияСпецификации) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.ОсновнаяВерсия КАК ОсновнаяВерсия,
		|	Т.ДополняющаяВерсия КАК ДополняющаяВерсия,
		|	Т.ВерсияИсправления КАК ВерсияИсправления,
		|	Т.Дата КАК Дата,
		|	Т.Автор КАК Автор,
		|	ПРЕДСТАВЛЕНИЕ(Т.Автор) КАК АвторПредставление
		|ИЗ
		|	Документ.кфкВерсияСпецификации КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка
		|	И Т.Проведен = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т.Объект КАК Объект,
		|	Т.НомерВерсии КАК НомерВерсии
		|ИЗ
		|	Документ.кфкВерсияСпецификации.ВерсииОбъектов КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ВерсияСпецификации);
	РезультатЗапроса = Запрос.ВыполнитьПакет();

	Выборка = РезультатЗапроса[0].Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение НСтр("ru = 'Версия спецификации не проведена'");
	КонецЕсли;

	Версия = Новый Структура;
	Версия.Вставить("Основная", Выборка.ОсновнаяВерсия);
	Версия.Вставить("Дополняющая", Выборка.ДополняющаяВерсия);
	Версия.Вставить("Исправления", Выборка.ВерсияИсправления);
	Версия.Вставить("Представление", СтрШаблон("%1.%2.%3",
		XMLСтрока(Версия.Основная), XMLСтрока(Версия.Дополняющая), XMLСтрока(Версия.Исправления)));

	Автор = Новый Структура;
	Автор.Вставить("ФИО", Выборка.АвторПредставление);
	ПользовательИБ = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		Пользователи.СвойстваПроверяемогоПользователяИБ(Выборка.Автор), "ПользовательИБ");
	Автор.Вставить("ЭлПочта", ?(ПользовательИБ = Неопределено, "", ПользовательИБ.АдресЭлектроннойПочты));
	Автор.Вставить("ДатаМодификации", Выборка.Дата);

	История = Новый Структура;
	История.Вставить("Спецификация", Новый Структура);
	История.Вставить("ТипыДанных", Новый Соответствие);
	История.Вставить("Перечисления", Новый Соответствие);
	История.Вставить("Каналы", Новый Соответствие);
	История.Вставить("Примеры", Новый Соответствие);
	История.Вставить("ПодчинныеТипыДанных", Новый Соответствие);

	Выборка = РезультатЗапроса[1].Выбрать();
	Пока Выборка.Следующий() Цикл

		ДанныеВерсии = ИсторияДанных.ПолучитьДанныеВерсии(Выборка.Объект, Выборка.НомерВерсии);
		Если ДанныеВерсии = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ТипОбъекта = ТипЗнч(Выборка.Объект);
		Если ТипОбъекта = Тип("СправочникСсылка.кфкСпецификации") Тогда
			Данные = Новый Структура(ДанныеВерсии);
			Данные.Вставить("Ссылка", Выборка.Объект);
			История.Спецификация = Новый ФиксированнаяСтруктура(Данные);
			Продолжить;

		ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.кфкТипыДанныхСпецификации") Тогда
			Коллекция = История.ТипыДанных;

		ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.кфкПеречисленияСпецификации") Тогда
			Коллекция = История.Перечисления;

		ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.кфкКаналыСпецификации") Тогда
			Коллекция = История.Каналы;

		ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.кфкПримерыСообщенийСпецификации") Тогда
			Коллекция = История.Примеры;

		Иначе
			ВызватьИсключение НСтр("ru = 'Неизвестный тип объекта'");
		КонецЕсли;

		Коллекция.Вставить(Выборка.Объект, ДанныеВерсии);

	КонецЦикла;

	Для Каждого Элемент Из История.ТипыДанных Цикл
		Родитель = Элемент.Значение.Родитель.Ссылка;
		ПодчинныеЭлементы = История.ПодчинныеТипыДанных.Получить(Родитель);
		Если ПодчинныеЭлементы = Неопределено Тогда
			ПодчинныеЭлементы = Новый Массив;
			История.ПодчинныеТипыДанных.Вставить(Родитель, ПодчинныеЭлементы);
		КонецЕсли;
		ПодчинныеЭлементы.Добавить(Элемент.Ключ);
	КонецЦикла;

	ПустойРодитель = Справочники.кфкТипыДанныхСпецификации.ПустаяСсылка();
	Если История.ПодчинныеТипыДанных.Получить(ПустойРодитель) = Неопределено Тогда
		История.ПодчинныеТипыДанных.Вставить(ПустойРодитель, Новый Массив);
	КонецЕсли;

	Возврат Новый Структура("Версия, Автор, История", Версия, Автор, История);

КонецФункции

#КонецОбласти

#Область ФормированиеAsyncAPI

// Формирует AsyncAPI для зафиксированной версии спецификации.
//
// Параметры:
//	ВерсияСпецификации - ДокументСсылка.кфкВерсияСпецификации - Проведенная версия спецификации.
//
// Возвращаемое значение:
//	см. СформироватьAsyncAPI
Функция СформироватьAsyncAPIВерсии(ВерсияСпецификации) Экспорт
	
	ТипФайла = Перечисления.кфкТипыФайловВерсииСпецификации.AsyncAPI_YAML;
	КЭШ = РегистрыСведений.кфкКЭШФайловВерсииСпецификации.ПолучитьКЭШ(ВерсияСпецификации, ТипФайла);
	Если КЭШ <> Неопределено Тогда
		Возврат КЭШ;
	КонецЕсли;
	
	ДанныеВерсии = ПолучитьДанныеВерсии(ВерсияСпецификации);
	Результат = СформироватьAsyncAPI(ДанныеВерсии);
	
	РегистрыСведений.кфкКЭШФайловВерсииСпецификации.ОбновитьКЭШ(ВерсияСпецификации, ТипФайла, Результат);
	
	Возврат Результат;
	
КонецФункции

// Формирует AsyncAPI из форматонезависимых данных версии.
//
// Параметры:
//	ДанныеВерсии - Структура - Результат ПолучитьДанныеВерсии.
//
// Возвращаемое значение:
//	Структура - Результат формирования:
//		* ИмяФайла - Строка - Имя файла.
//		* ДанныеФайла - ДвоичныеДанные - Двоичные данные YAML.
Функция СформироватьAsyncAPI(ДанныеВерсии) Экспорт

	Версия = ДанныеВерсии.Версия;
	Автор = ДанныеВерсии.Автор;
	История = ДанныеВерсии.История;
	ТДок = Новый ТекстовыйДокумент;

	ДобавитьСтроку(ТДок, 0, "asyncapi", СтрокаYAML("3.1.0"));
	ВертикальныйОтступ(ТДок);
	ДобавитьСтроку(ТДок, 0, "info");
	ДобавитьСтроку(ТДок, 1, "title", ИсторияСпецификация(История).Наименование);
	ДобавитьСтроку(ТДок, 1, "version", СтрокаYAML(Версия.Представление));

	ВертикальныйОтступ(ТДок);
	ДобавитьСтроку(ТДок, 0, "x-last-modified");
	ДобавитьСтроку(ТДок, 1, "at", СтрокаYAML(XMLСтрока(Автор.ДатаМодификации)));
	ДобавитьСтроку(ТДок, 1, "name", Автор.ФИО);
	Если Не ПустаяСтрока(Автор.ЭлПочта) Тогда
		ДобавитьСтроку(ТДок, 1, "email", Автор.ЭлПочта);
	КонецЕсли;

	ВертикальныйОтступ(ТДок);
	ДобавитьСтроку(ТДок, 0, "defaultContentType", "application/json");

	ДобавитьКаналы(ТДок, История);
	ДобавитьОперации(ТДок, История);
	ДобавитьКомпоненты(ТДок, История);

	Поток = Новый ПотокВПамяти;
	ТДок.Записать(Поток);
	ДанныеФайла = Поток.ЗакрытьИПолучитьДвоичныеДанные();

	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла", СтрШаблон("AsyncAPI-%1.yaml", Версия.Представление));
	Результат.Вставить("ДанныеФайла", ДанныеФайла);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ПодборПолей

// Заполняет дерево данными для подбора полей типа данных.
//
// Параметры:
//	Дерево - ДеревоЗначений - Дерево с колонками формы подбора.
//	ОбъектКонфигурации - СправочникСсылка.Объекты, СправочникСсылка.Свойства - Источник полей.
//	Спецификация - СправочникСсылка.кфкСпецификации - Спецификация.
//	ТипДанных - СправочникСсылка.кфкТипыДанныхСпецификации - Заполняемый тип данных.
Процедура ЗаполнитьДерево(Дерево, ОбъектКонфигурации, Спецификация, ТипДанных) Экспорт

	Дерево.Строки.Очистить();
	Свойства = СвойстваОбъектаКонфигурации(ОбъектКонфигурации);
	ПеречисленияСпецификации = ПеречисленияСпецификации(Спецификация);
	ЭлементыТипаДанных = Справочники.кфкТипыДанныхСпецификации.ПодчинныеЭлементы(ТипДанных);
	СвойстваТипаДанных = НавигацияПоКолонке(ЭлементыТипаДанных, "ОбъектКонфигурации");

	Для Каждого Реквизит Из Свойства.Реквизиты Цикл
		ДобавитьСвойствоВДерево(Дерево.Строки, Реквизит, СвойстваТипаДанных, ПеречисленияСпецификации);
	КонецЦикла;

	Для Каждого ТабличнаяЧасть Из Свойства.ТабличныеЧасти Цикл

		Свойство = СвойстваТипаДанных.Получить(ТабличнаяЧасть.Ссылка);
		Если Свойство <> Неопределено И Не ЕстьНовыеРеквизиты(ТабличнаяЧасть, СвойстваТипаДанных) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Дерево.Строки.Добавить();
		НоваяСтрока.СвойствоКонфигурации = ТабличнаяЧасть.Ссылка;
		НоваяСтрока.Свойство = ?(Свойство = Неопределено, Неопределено, Свойство.Код);
		НоваяСтрока.ТипДанных = Справочники.кфкТипыЗначенийСпецификации.Массив;
		НоваяСтрока.Ссылка = ?(Свойство = Неопределено, Неопределено, Свойство.Ссылка);

		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			ДобавитьСвойствоВДерево(
				НоваяСтрока.Строки, Реквизит, СвойстваТипаДанных, ПеречисленияСпецификации);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ИменаСпецификаций

// Формирует техническое имя по шаблону.
//
// Параметры:
//	ИсходныйШаблон - Строка - Шаблон с тегами %ТИП% и %ОПЕРАЦИЯ%.
//	ИмяТипа - Строка - Имя типа данных.
//	Операция - Строка - Действие системы-владельца: send или receive.
//
// Возвращаемое значение:
//	Строка - Сформированное имя.
Функция СформироватьИмя(Знач ИсходныйШаблон, Знач ИмяТипа, Знач Операция = "") Экспорт

	ТекстОшибки = ПроверитьШаблон(ИсходныйШаблон);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	Если ПустаяСтрока(ИмяТипа) Тогда
		ВызватьИсключение НСтр("ru = 'Не задано имя типа данных.'");
	КонецЕсли;

	ЧастиШаблона = РазложитьШаблон(ИсходныйШаблон);
	ЧастиТипа = РазложитьИмяТипаВМассивСлов(ИмяТипа);
	Результат = Новый Массив;

	Для Каждого Шаблон Из ЧастиШаблона Цикл

		Если ТипЗнч(Шаблон) = Тип("Строка") Тогда
			Результат.Добавить(Шаблон);
			Продолжить;
		КонецЕсли;

		Если НРег(Шаблон.Ключ) = "тип" Тогда
			ЗначениеТега = Новый Массив;
			РегистрСлова = Шаблон.РегистрПервогоСлова;
			Для Каждого Часть Из ЧастиТипа Цикл
				ЗначениеТега.Добавить(СтрФормат(Часть, РегистрСлова));
				РегистрСлова = Шаблон.РегистрСледующихСлов;
			КонецЦикла;
			Результат.Добавить(СтрСоединить(ЗначениеТега, Шаблон.Разделитель));

		ИначеЕсли НРег(Шаблон.Ключ) = "операция" Тогда
			Результат.Добавить(?(ПустаяСтрока(Шаблон.РегистрПервогоСлова), Операция,
				СтрФормат(Операция, Шаблон.РегистрПервогоСлова)));

		КонецЕсли;

	КонецЦикла;

	Возврат СтрСоединить(Результат);

КонецФункции

// Проверяет синтаксис шаблона технического имени.
//
// Параметры:
//	ИсходныйШаблон - Строка - Проверяемый шаблон.
//
// Возвращаемое значение:
//	Строка - Текст ошибки; пустая строка, если шаблон корректен.
Функция ПроверитьШаблон(Знач ИсходныйШаблон) Экспорт

	Если ПустаяСтрока(ИсходныйШаблон) Тогда
		Возврат НСтр("ru = 'Не задан шаблон имени.'");
	КонецЕсли;

	РегулярноеВыражение = "%(ТИП|ОПЕРАЦИЯ)(:(аа)([-_.]?)(аа)?)?%";
	Вхождения = СтрНайтиВсеПоРегулярномуВыражению(ИсходныйШаблон, РегулярноеВыражение, Истина);
	ТекущаяПозиция = 1;
	ТекстВнеТегов = "";

	Для Каждого Вхождение Из Вхождения Цикл
		ТекстВнеТегов = ТекстВнеТегов
			+ Сред(ИсходныйШаблон, ТекущаяПозиция, Вхождение.НачальнаяПозиция - ТекущаяПозиция);
		ТекущаяПозиция = Вхождение.НачальнаяПозиция + Вхождение.Длина;
	КонецЦикла;
	ТекстВнеТегов = ТекстВнеТегов + Сред(ИсходныйШаблон, ТекущаяПозиция);

	Если СтрНайти(ТекстВнеТегов, "%") > 0 Тогда
		Возврат НСтр("ru = 'Шаблон содержит неизвестный или поврежденный тег.'");
	КонецЕсли;

	Возврат "";

КонецФункции

// Проверяет технический идентификатор AsyncAPI.
//
// Параметры:
//	Значение - Строка - Проверяемое значение.
//
// Возвращаемое значение:
//	Строка - Текст ошибки; пустая строка, если идентификатор корректен.
Функция ПроверитьТехническийИдентификатор(Знач Значение) Экспорт

	Если ПустаяСтрока(Значение) Тогда
		Возврат НСтр("ru = 'Укажите значение латинскими буквами, цифрами или знаками ""."", ""_"", ""-"".'");
	ИначеЕсли Значение = "." Или Значение = ".." Тогда
		Возврат НСтр("ru = 'Укажите другое значение: ""."" и "".."" использовать нельзя.'");
	ИначеЕсли Не СодержитТолькоДопустимыеСимволы(Значение) Тогда
		Возврат НСтр("ru = 'Используйте только латинские буквы, цифры и знаки ""."", ""_"", ""-"".'");
	КонецЕсли;

	Возврат "";

КонецФункции

// Проверяет адрес Kafka topic.
//
// Параметры:
//	Значение - Строка - Проверяемый адрес.
//
// Возвращаемое значение:
//	Строка - Текст ошибки; пустая строка, если адрес корректен.
Функция ПроверитьАдресТопика(Знач Значение) Экспорт

	ТекстОшибки = ПроверитьТехническийИдентификатор(Значение);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	ИначеЕсли СтрДлина(Значение) > 249 Тогда
		Возврат НСтр("ru = 'Адрес топика не должен превышать 249 символов.'");
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#Область ПроверкаСпецификаций

// Проверяет текущую спецификацию перед выпуском версии.
//
// Параметры:
//	Спецификация - СправочникСсылка.кфкСпецификации - Проверяемая спецификация.
//
// Возвращаемое значение:
//	Массив из Структура - Ошибки проверки:
//		* КодПравила - Строка - Код правила.
//		* Объект - ЛюбаяСсылка - Объект с ошибкой.
//		* ИмяПоля - Строка - Имя поля.
//		* ТекстОшибки - Строка - Описание ошибки.
Функция ПроверитьСпецификацию(Спецификация) Экспорт

	Ошибки = Новый Массив;
	Данные = ПолучитьДанныеПроверки(Спецификация);

	ПроверитьШаблоны(Данные, Ошибки);
	ПроверитьКодыТиповДанных(Данные, Ошибки);
	ПроверитьИменаПеречислений(Данные, Ошибки);
	ПроверитьКаналыИКоллизии(Данные, Ошибки);

	Возврат Ошибки;

КонецФункции

#КонецОбласти

#КонецОбласти

