#Область Версионирование

// Возвращает индекс повышения для события создания, удаления или восстановления объекта.
//
// Параметры:
//	История - ИнформацияОЗаписиВерсииИсторииДанных - Сведения о записанной версии.
//	ЭтоНовый - Булево - Признак отсутствия базовой версии.
//	ВидПовышенияНового - ПеречислениеСсылка.кфкВидыПовышенияВерсий - Повышение при добавлении.
//	ВидПовышенияУдаленного - ПеречислениеСсылка.кфкВидыПовышенияВерсий - Повышение при удалении.
//
// Возвращаемое значение:
//	Число - Индекс повышения.
Функция ПолучитьИндексСобытия(История, ЭтоНовый, ВидПовышенияНового, ВидПовышенияУдаленного) Экспорт

	Если ТипЗнч(История) <> Тип("ИнформацияОЗаписиВерсииИсторииДанных") Тогда
		ВызватьИсключение НСтр("ru = 'Ожидались сведения о записанной версии истории данных.'");
	КонецЕсли;

	ВидыПовышения = Перечисления.кфкВидыПовышенияВерсий;
	Если ЭтоНовый Тогда
		Если История.ВидИзмененияДанных = ВидИзмененияДанных.Добавление Тогда
			ВидПовышения = ВидПовышенияНового;

		ИначеЕсли История.ВидИзмененияДанных = ВидИзмененияДанных.Изменение Тогда
			ВидПовышения = ?(
				ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(История.ДанныеВерсии, "ПометкаУдаления", Ложь),
				ВидыПовышения.ПустаяСсылка(), ВидПовышенияНового);

		Иначе
			ВидПовышения = ВидыПовышения.ПустаяСсылка();

		КонецЕсли;

	ИначеЕсли История.ВидИзмененияДанных = ВидИзмененияДанных.Удаление Тогда
		ВидПовышения = ВидПовышенияУдаленного;

	Иначе
		ВызватьИсключение НСтр("ru = 'Недопустимый сценарий изменения!'");

	КонецЕсли;

	Возврат ИндексВидаПовышения(ВидПовышения);

КонецФункции

// Возвращает наиболее значимый индекс из переданных видов повышения.
//
// Параметры:
//	ВидыПовышения - Массив Из ПеречислениеСсылка.кфкВидыПовышенияВерсий - Виды повышения.
//
// Возвращаемое значение:
//	Число - Индекс повышения; -1, если массив пуст.
Функция ПолучитьИндексИзменений(ВидыПовышения) Экспорт

	Результат = -1;
	Для Каждого ВидПовышения Из ВидыПовышения Цикл
		Индекс = ИндексВидаПовышения(ВидПовышения);
		Результат = ?(Результат = -1, Индекс, Мин(Результат, Индекс));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Версионирование

Функция ИндексВидаПовышения(ВидПовышения)

	ИндексыПовышения = Перечисления.кфкВидыПовышенияВерсий.Индексы();
	Индекс = ИндексыПовышения.Найти(ВидПовышения);
	Возврат ?(Индекс = Неопределено, -1, Индекс);

КонецФункции

#КонецОбласти

#Область ФормированиеВерсии

#Область ФормированиеAsyncAPI

Функция СтрокаYAML(Значение, Уровень = 0)

	Если СтрЧислоВхождений(Значение, Символы.ПС) = 0 Тогда
		Возврат "'" + СтрЗаменить(Значение, "'", "''") + "'";
	КонецЕсли;

	Части = СтрРазделить(Значение, Символы.ПС, Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат Значение;
	КонецЕсли;

	Отступ = СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов(" ", (Уровень + 1) * 2);
	Для Индекс = 0 По Части.ВГраница() Цикл
		Части[Индекс] = Отступ + СокрЛП(Части[Индекс]);
	КонецЦикла;
	Части.Вставить(0, "|-");

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

Процедура ДобавитьСтроку(ТДок, Уровень, Ключ = Неопределено, Значение = Неопределено, ЭлементМассив = Ложь)

	Отступ = СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов(" ", Уровень * 2);
	Если Ключ = Неопределено И Значение = Неопределено Тогда
		ТДок.ДобавитьСтроку("");
	ИначеЕсли Ключ <> Неопределено И Значение <> Неопределено Тогда
		ТДок.ДобавитьСтроку(Отступ + ?(ЭлементМассив, "- ", "")
			+ Ключ + ":" + ?(ПустаяСтрока(Значение), "", " " + Значение));
	ИначеЕсли Ключ <> Неопределено И Значение = Неопределено Тогда
		ТДок.ДобавитьСтроку(Отступ + Ключ + ":");
	ИначеЕсли Ключ = Неопределено И Значение <> Неопределено Тогда
		ТДок.ДобавитьСтроку(Отступ + "- " + Значение);
	КонецЕсли;

КонецПроцедуры

Процедура ВертикальныйОтступ(ТДок)
	ТДок.ДобавитьСтроку("");
КонецПроцедуры

#Область ЗаполнениеСпецификации

Процедура ДобавитьКаналы(ТДок, История)

	Список = СписокАктивныхКаналов(История);
	Если Список.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Спецификация = ИсторияСпецификация(История);
	ВертикальныйОтступ(ТДок);
	ДобавитьСтроку(ТДок, 0, "channels");

	Для Каждого Элемент Из Список Цикл

		Канал = ИсторияКанал(История, Элемент.Значение);
		ТипДанных = ИсторияТипДанных(История, Канал.ТипДанных);
		ШаблонТопика = ?(ПустаяСтрока(Канал.АдресТопика), Спецификация.АдресТопика, Канал.АдресТопика);
		ШаблонКанала = ?(ПустаяСтрока(Канал.ИмяКанала), Спецификация.ИмяКанала, Канал.ИмяКанала);
		ШаблонСообщения = ?(ПустаяСтрока(Канал.ИмяСообщения),
			Спецификация.ИмяСообщения, Канал.ИмяСообщения);
		ШаблонСообщенияКанала = ?(ПустаяСтрока(Канал.ИмяСообщенияКанала),
			Спецификация.ИмяСообщенияКанала, Канал.ИмяСообщенияКанала);

		АдресТопика = СформироватьИмя(ШаблонТопика, ТипДанных.Код);
		ИмяКанала = СформироватьИмя(ШаблонКанала, ТипДанных.Код);
		ИмяСообщения = СформироватьИмя(ШаблонСообщения, ТипДанных.Код);
		ИмяСообщенияКанала = СформироватьИмя(ШаблонСообщенияКанала, ТипДанных.Код);
		СсылкаСообщения = СтрШаблон("#/components/messages/%1", ИмяСообщения);

		ДобавитьСтроку(ТДок, 1, ИмяКанала);
		ДобавитьСтроку(ТДок, 2, "title", Канал.Наименование);
		ДобавитьСтроку(ТДок, 2, "address", АдресТопика);
		ДобавитьСтроку(ТДок, 2, "messages");
		ДобавитьСтроку(ТДок, 3, ИмяСообщенияКанала);
		ДобавитьСтроку(ТДок, 4, "$ref", СтрокаYAML(СсылкаСообщения));

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьОперации(ТДок, История)

	Список = СписокАктивныхКаналов(История);
	Если Список.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Спецификация = ИсторияСпецификация(История);
	ВертикальныйОтступ(ТДок);
	ДобавитьСтроку(ТДок, 0, "operations");

	Для Каждого Элемент Из Список Цикл

		Канал = ИсторияКанал(История, Элемент.Значение);
		ТипДанных = ИсторияТипДанных(История, Канал.ТипДанных);
		Операция = ?(Спецификация.Владелец.Ссылка = Канал.Отправитель.Ссылка, "send", "receive");
		ШаблонКанала = ?(ПустаяСтрока(Канал.ИмяКанала), Спецификация.ИмяКанала, Канал.ИмяКанала);
		ШаблонОперации = ?(ПустаяСтрока(Канал.ИмяОперации),
			Спецификация.ИмяОперации, Канал.ИмяОперации);
		ШаблонСообщенияКанала = ?(ПустаяСтрока(Канал.ИмяСообщенияКанала),
			Спецификация.ИмяСообщенияКанала, Канал.ИмяСообщенияКанала);

		ИмяКанала = СформироватьИмя(ШаблонКанала, ТипДанных.Код);
		ИмяОперации = СформироватьИмя(ШаблонОперации, ТипДанных.Код, Операция);
		ИмяСообщенияКанала = СформироватьИмя(ШаблонСообщенияКанала, ТипДанных.Код);
		СсылкаКанала = СтрШаблон("#/channels/%1", ИмяКанала);
		СсылкаСообщенияКанала = СтрШаблон("%1/messages/%2", СсылкаКанала, ИмяСообщенияКанала);

		ДобавитьСтроку(ТДок, 1, ИмяОперации);
		ДобавитьСтроку(ТДок, 2, "action", Операция);
		ДобавитьСтроку(ТДок, 2, "channel");
		ДобавитьСтроку(ТДок, 3, "$ref", СтрокаYAML(СсылкаКанала));
		ДобавитьСтроку(ТДок, 2, "messages");
		ДобавитьСтроку(ТДок, 3, "$ref", СтрокаYAML(СсылкаСообщенияКанала), Истина);

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьКомпоненты(ТДок, История)

	ВертикальныйОтступ(ТДок);
	ДобавитьСтроку(ТДок, 0, "components");
	ДобавитьКомпонентСообщения(ТДок, История);

	ТипыЗначений = ДоступныеТипыЗначений();
	ТипыПолей = ДоступныеТипыПолей(История);
	ДобавитьСтроку(ТДок, 1, "schemas");
	ДобавитьКомпонентТипыДанных(ТДок, История, 2, Справочники.кфкТипыДанныхСпецификации.ПустаяСсылка(),
		ТипыЗначений, ТипыПолей);
	ДобавитьКомпонентПеречисления(ТДок, История, ТипыЗначений);

КонецПроцедуры

Процедура ДобавитьКомпонентСообщения(ТДок, История)

	Список = СписокАктивныхКаналов(История);
	Если Список.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Спецификация = ИсторияСпецификация(История);
	ДобавитьСтроку(ТДок, 1, "messages");

	Для Каждого Элемент Из Список Цикл

		Канал = ИсторияКанал(История, Элемент.Значение);
		ТипДанных = ИсторияТипДанных(История, Канал.ТипДанных);
		ШаблонСообщения = ?(ПустаяСтрока(Канал.ИмяСообщения),
			Спецификация.ИмяСообщения, Канал.ИмяСообщения);
		ИмяСообщения = СформироватьИмя(ШаблонСообщения, ТипДанных.Код);
		ИмяСхемы = СформироватьИмя(Спецификация.ИмяСхемы, ТипДанных.Код);
		СсылкаСхемы = СтрШаблон("#/components/schemas/%1", ИмяСхемы);

		ДобавитьСтроку(ТДок, 2, ИмяСообщения);
		ДобавитьСтроку(ТДок, 3, "name", ИмяСообщения);
		ДобавитьСтроку(ТДок, 3, "payload");
		ДобавитьСтроку(ТДок, 4, "$ref", СтрокаYAML(СсылкаСхемы));

	КонецЦикла;

КонецПроцедуры

Функция СписокАктивныхКаналов(История)

	Список = Новый СписокЗначений;
	Для Каждого Канал Из История.Каналы Цикл
		Если Канал.Значение.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		ТипДанных = ИсторияТипДанных(История, Канал.Значение.ТипДанных);
		Список.Добавить(Канал.Ключ, ТипДанных.Код);
	КонецЦикла;
	Список.СортироватьПоПредставлению();

	Возврат Список;

КонецФункции

#КонецОбласти

#Область ЗаполнениеСхем

Процедура ДобавитьКомпонентТипыДанных(ТДок, История, Уровень, Родитель, ТипыЗначений, ТипыПолей,
		ОбязательныеСвойстваРодителя = Неопределено)

	Список = Новый СписокЗначений;
	Для Каждого Элемент Из ПодчинныеДля(История, Родитель) Цикл

		ТипДанных = ИсторияТипДанных(История, Элемент);
		Если ТипДанных = Неопределено Или ТипДанных.ПометкаУдаления Или ТипДанных.Родитель.Ссылка <> Родитель Тогда
			Продолжить;
		КонецЕсли;

		Порядок = "0";
		ТипЗначенияСсылка = ТипДанных.ТипДанных.Ссылка;
		Если ТипЗначенияСсылка = Справочники.кфкТипыЗначенийСпецификации.Строка
				Или ТипЗначенияСсылка = Справочники.кфкТипыЗначенийСпецификации.Число
				Или ТипЗначенияСсылка = Справочники.кфкТипыЗначенийСпецификации.ЦелоеЧисло
				Или ТипЗначенияСсылка = Справочники.кфкТипыЗначенийСпецификации.Логический Тогда
			Порядок = "01";
		ИначеЕсли ТипЗначенияСсылка = Справочники.кфкТипыЗначенийСпецификации.Структура Тогда
			Порядок = "02";
		ИначеЕсли ТипЗначенияСсылка = Справочники.кфкТипыЗначенийСпецификации.Массив Тогда
			Порядок = "03";
		КонецЕсли;

		Список.Добавить(Элемент, Порядок + "-" + ТипДанных.Код);

	КонецЦикла;
	Список.СортироватьПоПредставлению();

	Если Список.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Спецификация = ИсторияСпецификация(История);
	Для Каждого Элемент Из Список Цикл

		ТипДанных = ИсторияТипДанных(История, Элемент.Значение);
		ИмяТипа = ?(Родитель.Пустая(),
			СформироватьИмя(Спецификация.ИмяСхемы, ТипДанных.Код), ТипДанных.Код);

		ДобавитьСтроку(ТДок, Уровень, ИмяТипа);
		ДобавитьОписаниеТипаДанных(
			ТДок, История, Уровень, ТипДанных, Элемент.Значение, ТипыЗначений, ТипыПолей);

		Если ОбязательныеСвойстваРодителя <> Неопределено И ТипДанных.Обязательное Тогда
			ОбязательныеСвойстваРодителя.Добавить(ИмяТипа);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьОписаниеТипаДанных(
		ТДок, История, Уровень, ТипДанных, ТипДанныхСсылка, ТипыЗначений, ТипыПолей)

	ТипЗначенияСсылка = ТипДанных.ТипДанных.Ссылка;
	Если Не ПустаяСтрока(ТипДанных.Наименование) Тогда
		ДобавитьСтроку(ТДок, Уровень + 1, "title", ТипДанных.Наименование);
	КонецЕсли;
	Если Не ПустаяСтрока(ТипДанных.Описание) Тогда
		ДобавитьСтроку(ТДок, Уровень + 1, "description", СтрокаYAML(ТипДанных.Описание, Уровень + 1));
	КонецЕсли;
	Если ТипДанных.Устарело Тогда
		ДобавитьСтроку(ТДок, Уровень + 1, "deprecated", XMLСтрока(ТипДанных.Устарело));
	КонецЕсли;

	Если Не ТипДанных.Перечисление.Ссылка.Пустая() Тогда
		Перечисление = ИсторияПеречисление(История, ТипДанных.Перечисление.Ссылка);
		СсылкаПеречисления = СтрШаблон("#/components/schemas/%1", Перечисление.Наименование);
		ДобавитьСтроку(ТДок, Уровень + 1, "$ref", СтрокаYAML(СсылкаПеречисления));
		Возврат;
	КонецЕсли;

	ПодчинныеТипы = ПодчинныеДля(История, ТипДанныхСсылка);
	Если ТипДанных.БазовыеТипы.Количество() = 1 И ПодчинныеТипы.Количество() = 0 Тогда
		БазовыйТип = ИсторияТипДанных(История, ТипДанных.БазовыеТипы[0].Тип.Ссылка);
		ИмяБазовогоТипа = СформироватьИмя(
			ИсторияСпецификация(История).ИмяСхемы, БазовыйТип.Код);
		СсылкаБазовыйТип = СтрШаблон("#/components/schemas/%1", ИмяБазовогоТипа);
		ДобавитьСтроку(ТДок, Уровень + 1, "$ref", СтрокаYAML(СсылкаБазовыйТип));
		Возврат;
	КонецЕсли;

	СмещениеУровня = 0;
	Если ТипДанных.БазовыеТипы.Количество() > 1 Тогда
		ДобавитьСтроку(ТДок, Уровень + 1, "allOf");
		Для Каждого Строка Из ТипДанных.БазовыеТипы Цикл
			БазовыйТип = ИсторияТипДанных(История, Строка.Тип.Ссылка);
			ИмяБазовогоТипа = СформироватьИмя(
				ИсторияСпецификация(История).ИмяСхемы, БазовыйТип.Код);
			СсылкаБазовыйТип = СтрШаблон("#/components/schemas/%1", ИмяБазовогоТипа);
			ДобавитьСтроку(ТДок, Уровень + 2, "$ref", СтрокаYAML(СсылкаБазовыйТип), Истина);
		КонецЦикла;
		СмещениеУровня = 1;
	КонецЕсли;

	ДобавитьСтроку(
		ТДок, Уровень + СмещениеУровня + 1, "type", ТипыЗначений.Получить(ТипЗначенияСсылка));

	Если Не ТипДанных.ФорматДанных.Ссылка.Пустая() Тогда
		ДобавитьСтроку(ТДок, Уровень + СмещениеУровня + 1, "format",
			ТипыЗначений.Получить(ТипДанных.ФорматДанных.Ссылка));
	КонецЕсли;

	Если ТипЗначенияСсылка = Справочники.кфкТипыЗначенийСпецификации.Структура Тогда
		ДобавитьСтроку(ТДок, Уровень + СмещениеУровня + 1, "properties");
		ОбязательныеСвойства = Новый Массив;
		ДобавитьКомпонентТипыДанных(ТДок, История, Уровень + СмещениеУровня + 2, ТипДанныхСсылка,
			ТипыЗначений, ТипыПолей, ОбязательныеСвойства);
		Если ОбязательныеСвойства.Количество() > 0 Тогда
			ДобавитьСтроку(ТДок, Уровень + СмещениеУровня + 1, "required");
			Для Каждого Элемент Из ОбязательныеСвойства Цикл
				ДобавитьСтроку(ТДок, Уровень + СмещениеУровня + 2, , Элемент);
			КонецЦикла;
		КонецЕсли;

	ИначеЕсли ТипЗначенияСсылка = Справочники.кфкТипыЗначенийСпецификации.Массив Тогда
		Если ТипДанных.Минимум <> -1 Тогда
			ДобавитьСтроку(
				ТДок, Уровень + СмещениеУровня + 1, "minItems", XMLСтрока(ТипДанных.Минимум));
		КонецЕсли;
		Если ТипДанных.Максимум <> -1 Тогда
			ДобавитьСтроку(
				ТДок, Уровень + СмещениеУровня + 1, "maxItems", XMLСтрока(ТипДанных.Максимум));
		КонецЕсли;
		ДобавитьСтроку(ТДок, Уровень + СмещениеУровня + 1, "items");
		ЭлементМассиваСсылка = ПодчинныеТипы[0];
		ЭлементМассива = ИсторияТипДанных(История, ЭлементМассиваСсылка);
		ДобавитьОписаниеТипаДанных(ТДок, История, Уровень + СмещениеУровня + 2,
			ЭлементМассива, ЭлементМассиваСсылка, ТипыЗначений, ТипыПолей);

	ИначеЕсли ТипЗначенияСсылка = Справочники.кфкТипыЗначенийСпецификации.Строка Тогда
		ДобавитьОграниченияСтроки(ТДок, Уровень, СмещениеУровня, ТипДанных);
		ДобавитьОписаниеСсылочногоЗначения(ТДок, Уровень, СмещениеУровня, ТипДанных, ТипДанныхСсылка, ТипыПолей);
		
	ИначеЕсли ТипЗначенияСсылка = Справочники.кфкТипыЗначенийСпецификации.Число Тогда
		ДобавитьОграниченияЧисла(ТДок, Уровень, СмещениеУровня, ТипДанных);

	ИначеЕсли ТипЗначенияСсылка = Справочники.кфкТипыЗначенийСпецификации.ЦелоеЧисло
			Или ТипЗначенияСсылка = Справочники.кфкТипыЗначенийСпецификации.Логический Тогда
		ДобавитьЗначениеПоУмолчанию(ТДок, Уровень, ТипДанных);

	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьОграниченияСтроки(ТДок, Уровень, СмещениеУровня, ТипДанных)

	Если ТипДанных.Минимум <> -1 Тогда
		ДобавитьСтроку(ТДок, Уровень + СмещениеУровня + 1, "minLength", XMLСтрока(ТипДанных.Минимум));
	КонецЕсли;
	Если ТипДанных.Максимум <> -1 Тогда
		ДобавитьСтроку(ТДок, Уровень + СмещениеУровня + 1, "maxLength", XMLСтрока(ТипДанных.Максимум));
	КонецЕсли;
	Если Не ПустаяСтрока(ТипДанных.РегулярноеВыражение) Тогда
		ДобавитьСтроку(
			ТДок, Уровень + СмещениеУровня + 1, "pattern", ТипДанных.РегулярноеВыражение);
	КонецЕсли;
	ДобавитьЗначениеПоУмолчанию(ТДок, Уровень, ТипДанных);

КонецПроцедуры

Процедура ДобавитьОграниченияЧисла(ТДок, Уровень, СмещениеУровня, ТипДанных)

	Если ТипДанных.Минимум <> -1 Тогда
		ДобавитьСтроку(ТДок, Уровень + СмещениеУровня + 1, "minimum", XMLСтрока(ТипДанных.Минимум));
	КонецЕсли;
	Если ТипДанных.Максимум <> -1 Тогда
		ДобавитьСтроку(ТДок, Уровень + СмещениеУровня + 1, "maximum", XMLСтрока(ТипДанных.Максимум));
	КонецЕсли;
	ДобавитьЗначениеПоУмолчанию(ТДок, Уровень, ТипДанных);

КонецПроцедуры

Процедура ДобавитьЗначениеПоУмолчанию(ТДок, Уровень, ТипДанных)

	Если ЗначениеЗаполнено(ТипДанных.ЗначениеПоУмолчанию) Тогда
		ДобавитьСтроку(ТДок, Уровень + 1, "default", XMLСтрока(ТипДанных.ЗначениеПоУмолчанию));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьОписаниеСсылочногоЗначения(ТДок, Уровень, СмещениеУровня, ТипДанных, ТипДанныхСсылка, ТипыПолей)
	
	Если ТипДанных.ФорматДанных.Ссылка <> Справочники.кфкТипыЗначенийСпецификации.УникальныйИдентификатор Тогда
		Возврат;
	КонецЕсли;
	
	Типы = ТипыПолей.Получить(ТипДанныхСсылка);
	Если Типы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьСтроку(ТДок, Уровень + 1, "x-topics");
	Для Каждого Тип Из Типы Цикл
		ДобавитьСтроку(ТДок, Уровень + 2, , Тип);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Перечисления

Процедура ДобавитьКомпонентПеречисления(ТДок, История, ТипыЗначений)

	Список = Новый СписокЗначений;
	Для Каждого Перечисление Из История.Перечисления Цикл
		Если Не Перечисление.Значение.ПометкаУдаления Тогда
			Список.Добавить(Перечисление.Ключ, Перечисление.Значение.Код);
		КонецЕсли;
	КонецЦикла;
	Список.СортироватьПоПредставлению();

	Для Каждого Элемент Из Список Цикл

		Перечисление = ИсторияПеречисление(История, Элемент.Значение);
		ДобавитьСтроку(ТДок, 2, Перечисление.Наименование);
		ДобавитьСтроку(ТДок, 3, "type", ТипыЗначений.Получить(Перечисление.ТипЗначения.Ссылка));
		ДобавитьСтроку(ТДок, 3, "enum");
		Для Каждого Значение Из Перечисление.Значения Цикл
			ДобавитьСтроку(ТДок, 4, , Значение.Значение);
		КонецЦикла;

		Если Перечисление.Значения.Количество() > 0
				И Не ПустаяСтрока(Перечисление.Значения[0].Представление) Тогда
			ДобавитьСтроку(ТДок, 3, "x-enumNames");
			Для Каждого Значение Из Перечисление.Значения Цикл
				ДобавитьСтроку(ТДок, 4, , Значение.Представление);
			КонецЦикла;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ДоступныеТипыЗначений()

	Результат = Новый Соответствие;
	Выборка = Справочники.кфкТипыЗначенийСпецификации.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.Код);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ДоступныеТипыПолей(История)
	
	Результат = Новый Соответствие; // {Справочник.кфкТипыДанныхСпецификации(Поля), [Справочник.кфкТипыДанныхСпецификации(Типы)]}
	
	ТипыСвойствКонфигурации = Новый Соответствие; // {Справочник.Свойства, [Справочник.Объекты]}
	ТипыДанных = Новый Соответствие; // {Справочник.Объекты, Справочник.кфкТипыДанныхСпецификации}
	Каналы = Новый Соответствие; // {Справочник.кфкТипыДанныхСпецификации, Строка}
	
	// Шаг 1 - получение типов свойств конфигурации
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т1.Ссылка КАК Ссылка,
		|	Т1.Тип КАК Тип
		|ИЗ
		|	Справочник.Свойства.Типы КАК Т1
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Объекты КАК Т2
		|		ПО Т1.Тип = Т2.Ссылка
		|ГДЕ
		|	Т2.Тип В (&СсылочныеТипыОбъектов)
		|ИТОГИ
		|ПО
		|	Ссылка";
	Запрос.УстановитьПараметр("СсылочныеТипыОбъектов", СсылочныеТипыОбъектов());
	ВыборкаСвойства = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСвойства.Следующий() Цикл
		
		Типы = Новый Массив;
		ТипыСвойствКонфигурации.Вставить(ВыборкаСвойства.Ссылка, Типы);
		
		Выборка = ВыборкаСвойства.Выбрать();
		Пока Выборка.Следующий() Цикл
			Типы.Добавить(Выборка.Тип);
		КонецЦикла;
		
	КонецЦикла;
	
	// Шаг 2 - Получаем типы данных спецификации объектов конфигурации
	ТипыДанныхСпецификации = ПодчинныеДля(История, Справочники.кфкТипыДанныхСпецификации.ПустаяСсылка());
	Для Каждого Элемент Из ТипыДанныхСпецификации Цикл
		
		ТипДанных = ИсторияТипДанных(История, Элемент);
		Если ТипДанных.ОбъектКонфигурации = Неопределено
				Или Не ЗначениеЗаполнено(ТипДанных.ОбъектКонфигурации.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ТипыДанных.Вставить(ТипДанных.ОбъектКонфигурации.Ссылка, Элемент);
		
	КонецЦикла;
	
	// Шаг 3 - Получаем шаблоны адресов топиков из каналов
	Для Каждого КлючЗначение Из История.Каналы Цикл
		
		Канал = КлючЗначение.Значение;
		Если ПустаяСтрока(Канал.АдресТопика) Тогда
			Продолжить;
		КонецЕсли;
		
		Каналы.Вставить(Канал.ТипДанных.Ссылка, Канал.АдресТопика);
		
	КонецЦикла;
	
	// Шаг 4 - Получаем общий шаблон адреса топика
	ШаблонТопика = ИсторияСпецификация(История).АдресТопика;
	
	// Шаг 4 - Получаем типы данных спецификации для ссылочных свойств конфигурации
	Для Каждого КлючЗначение Из История.ТипыДанных Цикл
		Поле = КлючЗначение.Значение;
		Если Поле.ОбъектКонфигурации = Неопределено
				Или Не ЗначениеЗаполнено(Поле.ОбъектКонфигурации.Ссылка)
				Или ТипЗнч(Поле.ОбъектКонфигурации.Ссылка) <> Тип("СправочникСсылка.Свойства") Тогда
			Продолжить;
		КонецЕсли;
		
		ТипыСвойств = ТипыСвойствКонфигурации.Получить(Поле.ОбъектКонфигурации.Ссылка); // Массив Из СправочникСсылка.Объекты
		Если ТипыСвойств = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Типы = Новый Массив;
		Для Каждого ТипСвойств Из ТипыСвойств Цикл
			
			ТипДанных = ТипыДанных.Получить(ТипСвойств);
			Если ТипДанных = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Шаблон = Каналы.Получить(ТипДанных);
			Если ПустаяСтрока(Шаблон) Тогда
				Шаблон = ШаблонТопика;
			КонецЕсли;
			
			АдресТопика = СформироватьИмя(Шаблон, ТипДанных.Код);
			Типы.Добавить(АдресТопика);
			
		КонецЦикла;
		
		Если Типы.Количество() > 0 Тогда
			Результат.Вставить(КлючЗначение.Ключ, Типы);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ИсторияДанных

Функция ИсторияСпецификация(История)
	Возврат История.Спецификация;
КонецФункции

Функция ИсторияКанал(История, Ссылка)
	Ключ = ?(ТипЗнч(Ссылка) = Тип("ФиксированнаяСтруктура"), Ссылка.Ссылка, Ссылка);
	Возврат История.Каналы.Получить(Ключ);
КонецФункции

Функция ИсторияТипДанных(История, Ссылка)
	Ключ = ?(ТипЗнч(Ссылка) = Тип("ФиксированнаяСтруктура"), Ссылка.Ссылка, Ссылка);
	Возврат История.ТипыДанных.Получить(Ключ);
КонецФункции

Функция ИсторияПеречисление(История, Ссылка)
	Ключ = ?(ТипЗнч(Ссылка) = Тип("ФиксированнаяСтруктура"), Ссылка.Ссылка, Ссылка);
	Возврат История.Перечисления.Получить(Ключ);
КонецФункции

Функция ПодчинныеДля(История, Родитель)

	Результат = История.ПодчинныеТипыДанных.Получить(Родитель);
	Возврат ?(Результат = Неопределено, Новый Массив, Результат);

КонецФункции

#КонецОбласти

#КонецОбласти

#КонецОбласти

#Область ПодборПолей

Функция ЕстьНовыеРеквизиты(ТабличнаяЧасть, СвойстваТипаДанных)

	Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
		Если СвойстваТипаДанных.Получить(Реквизит.Ссылка) = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СвойстваОбъектаКонфигурации(ОбъектКонфигурации)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Свойства.Ссылка КАК Ссылка,
	|	Свойства.Родитель КАК Родитель,
	|	Свойства.Наименование КАК Наименование,
	|	Свойства.Синоним КАК Синоним,
	|	Свойства.Вид КАК Вид,
	|	Свойства.КвалификаторыЧисла_Длина КАК КвалификаторыЧисла_Длина,
	|	Свойства.КвалификаторыЧисла_Точность КАК КвалификаторыЧисла_Точность,
	|	Свойства.КвалификаторыЧисла_Неотрицательное КАК КвалификаторыЧисла_Неотрицательное,
	|	Свойства.КвалификаторыСтроки_Длина КАК КвалификаторыСтроки_Длина,
	|	Свойства.КвалификаторыСтроки_Фиксированная КАК КвалификаторыСтроки_Фиксированная,
	|	Свойства.КвалификаторыДаты_Состав КАК КвалификаторыДаты_Состав,
	|	Свойства.ТипыСтрокой КАК ТипыСтрокой,
	|	СвойстваТипы.Тип КАК Тип,
	|	ВЫБОР
	|		КОГДА ТОбъекты.Тип В (&СсылочныеТипыОбъектов)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.УникальныйИдентификатор)
	|		ИНАЧЕ ТОбъекты.Тип
	|	КОНЕЦ КАК ТипТипа
	|ПОМЕСТИТЬ ВТВсеТипыСвойствОбъекта
	|ИЗ
	|	Справочник.Свойства КАК Свойства
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Свойства.Типы КАК СвойстваТипы
	|		ПО Свойства.Ссылка = СвойстваТипы.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Объекты КАК ТОбъекты
	|		ПО СвойстваТипы.Тип = ТОбъекты.Ссылка
	|ГДЕ
	|	(Свойства.Владелец = &ОбъектКонфигурации
	|	ИЛИ Свойства.Родитель = &ОбъектКонфигурации)
	|	И Свойства.ЭтоГруппа = ЛОЖЬ
	|	И Свойства.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТСвойстваСоставногоТипа
	|ИЗ
	|	ВТВсеТипыСвойствОбъекта КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.Ссылка
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Родитель КАК Родитель,
	|	Т.Наименование КАК Наименование,
	|	Т.Синоним КАК Синоним,
	|	Т.КвалификаторыЧисла_Длина КАК КвалификаторыЧисла_Длина,
	|	Т.КвалификаторыЧисла_Точность КАК КвалификаторыЧисла_Точность,
	|	Т.КвалификаторыЧисла_Неотрицательное КАК КвалификаторыЧисла_Неотрицательное,
	|	Т.КвалификаторыСтроки_Длина КАК КвалификаторыСтроки_Длина,
	|	Т.КвалификаторыСтроки_Фиксированная КАК КвалификаторыСтроки_Фиксированная,
	|	Т.КвалификаторыДаты_Состав КАК КвалификаторыДаты_Состав,
	|	Т.ТипыСтрокой КАК ТипыСтрокой,
	|	Т.Тип КАК Тип,
	|	Т.ТипТипа КАК ТипТипа
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		Т1.Ссылка КАК Ссылка,
	|		Т1.Родитель КАК Родитель,
	|		Т1.Наименование КАК Наименование,
	|		Т1.Синоним КАК Синоним,
	|		Т1.Вид КАК Вид,
	|		Т1.КвалификаторыЧисла_Длина КАК КвалификаторыЧисла_Длина,
	|		Т1.КвалификаторыЧисла_Точность КАК КвалификаторыЧисла_Точность,
	|		Т1.КвалификаторыЧисла_Неотрицательное КАК КвалификаторыЧисла_Неотрицательное,
	|		Т1.КвалификаторыСтроки_Длина КАК КвалификаторыСтроки_Длина,
	|		Т1.КвалификаторыСтроки_Фиксированная КАК КвалификаторыСтроки_Фиксированная,
	|		Т1.КвалификаторыДаты_Состав КАК КвалификаторыДаты_Состав,
	|		ВЫРАЗИТЬ(Т1.ТипыСтрокой КАК СТРОКА(1000)) КАК ТипыСтрокой,
	|		ВЫБОР
	|			КОГДА Т2.Ссылка ЕСТЬ NULL
	|				ТОГДА Т1.ТипТипа
	|		КОНЕЦ КАК ТипТипа,
	|		ВЫБОР
	|			КОГДА Т2.Ссылка ЕСТЬ NULL
	|				И Т3.Ссылка ЕСТЬ NULL
	|				ТОГДА Т1.Тип
	|		КОНЕЦ КАК Тип
	|	ИЗ
	|		ВТВсеТипыСвойствОбъекта КАК Т1
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТСвойстваСоставногоТипа КАК Т2
	|			ПО Т1.Ссылка = Т2.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТВсеТипыСвойствОбъекта КАК Т3
	|			ПО Т1.Ссылка = Т3.Ссылка
	|			И Т1.ТипТипа = Т3.ТипТипа
	|			И Т1.Тип <> Т3.Тип) КАК Т
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА Т.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыСвойств.ТабличнаяЧасть) ТОГДА 4
	|		КОГДА Т.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыСвойств.Реквизит) ТОГДА 3
	|		КОГДА Т.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыСвойств.Свойство) ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ,
	|	Т.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Свойства.Ссылка КАК Ссылка,
	|	Свойства.Наименование КАК Наименование,
	|	Свойства.Синоним КАК Синоним
	|ИЗ
	|	Справочник.Свойства КАК Свойства
	|ГДЕ
	|	Свойства.Владелец = &ОбъектКонфигурации
	|	И Свойства.Родитель = ЗНАЧЕНИЕ(Справочник.Свойства.ПустаяСсылка)
	|	И Свойства.ЭтоГруппа = ИСТИНА
	|	И Свойства.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Свойства.Наименование";
	Запрос.УстановитьПараметр("ОбъектКонфигурации", ОбъектКонфигурации);
	Запрос.УстановитьПараметр("СсылочныеТипыОбъектов", СсылочныеТипыОбъектов());
	РезультатЗапроса = Запрос.ВыполнитьПакет();

	Если ТипЗнч(ОбъектКонфигурации) = Тип("СправочникСсылка.Объекты") Тогда
		ВсеРеквизиты = РезультатЗапроса[РезультатЗапроса.ВГраница() - 1].Выгрузить();
		ВсеРеквизиты.Индексы.Добавить("Родитель");
		Реквизиты = ВсеРеквизиты.Скопировать(
			Новый Структура("Родитель", Справочники.Свойства.ПустаяСсылка()));
		//@skip-check bsl-legacy-check-expression-type
		Реквизиты.Колонки.Удалить("Родитель");

		ТабличныеЧасти = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выгрузить();
		ТабличныеЧасти.Колонки.Добавить("Реквизиты", Новый ОписаниеТипов("ТаблицаЗначений"));
		Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
			ТабличнаяЧасть.Реквизиты = ВсеРеквизиты.Скопировать(
				Новый Структура("Родитель", ТабличнаяЧасть.Ссылка));
			ТабличнаяЧасть.Реквизиты.Колонки.Удалить("Родитель");
		КонецЦикла;

	ИначеЕсли ТипЗнч(ОбъектКонфигурации) = Тип("СправочникСсылка.Свойства") Тогда
		Реквизиты = РезультатЗапроса[РезультатЗапроса.ВГраница() - 1].Выгрузить();
		//@skip-check bsl-legacy-check-expression-type
		Реквизиты.Колонки.Удалить("Родитель");
		ТабличныеЧасти = Новый Массив;

	Иначе
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Неизвестный тип объекта конфигурации: %1'"), ОбъектКонфигурации);
	КонецЕсли;

	Возврат Новый Структура("Реквизиты, ТабличныеЧасти", Реквизиты, ТабличныеЧасти);

КонецФункции

Функция ПеречисленияСпецификации(Спецификация)

	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Перечисления.Ссылка КАК Ссылка,
	|	Перечисления.ОбъектКонфигурации КАК ОбъектКонфигурации
	|ИЗ
	|	Справочник.кфкПеречисленияСпецификации КАК Перечисления
	|ГДЕ
	|	Перечисления.Владелец = &Спецификация
	|	И Перечисления.ПометкаУдаления = ЛОЖЬ
	|	И Перечисления.ОбъектКонфигурации <> ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Спецификация", Спецификация);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ОбъектКонфигурации, Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НавигацияПоКолонке(Дерево, ИмяКолонки, Приемник = Неопределено)

	Если Приемник = Неопределено Тогда
		Приемник = Новый Соответствие;
	КонецЕсли;

	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		Значение = СтрокаДерева[ИмяКолонки];
		Если ЗначениеЗаполнено(Значение) Тогда
			Приемник.Вставить(Значение, СтрокаДерева);
		КонецЕсли;
		НавигацияПоКолонке(СтрокаДерева, ИмяКолонки, Приемник);
	КонецЦикла;

	Возврат Приемник;

КонецФункции

Функция СсылочныеТипыОбъектов()

	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ТипыОбъектов.ЛюбаяСсылка);
	Результат.Добавить(Перечисления.ТипыОбъектов.Справочник);
	Результат.Добавить(Перечисления.ТипыОбъектов.Документ);
	Результат.Добавить(Перечисления.ТипыОбъектов.ПланВидовХарактеристик);
	Результат.Добавить(Перечисления.ТипыОбъектов.ПланСчетов);
	Результат.Добавить(Перечисления.ТипыОбъектов.ПланВидовРасчета);
	Результат.Добавить(Перечисления.ТипыОбъектов.ПланОбмена);
	Результат.Добавить(Перечисления.ТипыОбъектов.БизнесПроцесс);
	Результат.Добавить(Перечисления.ТипыОбъектов.Задача);
	Результат.Добавить(Перечисления.ТипыОбъектов.ТочкаМаршрутаБизнесПроцесса);
	Результат.Добавить(Перечисления.ТипыОбъектов.ВидРасчета);
	Результат.Добавить(Перечисления.ТипыОбъектов.ВидСубконто);

	Возврат Результат;

КонецФункции

Процедура ДобавитьСвойствоВДерево(Строки, Реквизит, СвойстваТипаДанных, ПеречисленияСпецификации)

	Если СвойстваТипаДанных.Получить(Реквизит.Ссылка) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	НоваяСтрока = Строки.Добавить();
	НоваяСтрока.СвойствоКонфигурации = Реквизит.Ссылка;
	НоваяСтрока.СвойствоКонфигурацииНаименование = Реквизит.Наименование;
	НоваяСтрока.СвойствоКонфигурацииСиноним = Реквизит.Синоним;
	НоваяСтрока.ТипСвойстваКонфигурации = Реквизит.ТипыСтрокой;
	НоваяСтрока.Тип = Реквизит.Тип;
	НоваяСтрока.ТипТипа = Реквизит.ТипТипа;
	НоваяСтрока.Свойство = Неопределено;
	НоваяСтрока.ТипДанных = Неопределено;
	НоваяСтрока.ФорматДанных = Неопределено;
	НоваяСтрока.Перечисление = Неопределено;
	НоваяСтрока.Минимум = Неопределено;
	НоваяСтрока.Максимум = Неопределено;
	НоваяСтрока.Ссылка = Неопределено;

	ЗаполнитьТипСвойства(НоваяСтрока, Реквизит, ПеречисленияСпецификации);

КонецПроцедуры

Процедура ЗаполнитьТипСвойства(НоваяСтрока, Реквизит, ПеречисленияСпецификации)

	ТипыЗначений = Справочники.кфкТипыЗначенийСпецификации;
	Если Реквизит.ТипТипа = Перечисления.ТипыОбъектов.Строка Тогда
		НоваяСтрока.ТипДанных = ТипыЗначений.Строка;
		НоваяСтрока.Максимум = ?(
			Реквизит.КвалификаторыСтроки_Длина = 0, Неопределено, Реквизит.КвалификаторыСтроки_Длина);

	ИначеЕсли Реквизит.ТипТипа = Перечисления.ТипыОбъектов.Число Тогда
		Если Реквизит.КвалификаторыЧисла_Точность = 0 Тогда
			НоваяСтрока.ТипДанных = ТипыЗначений.ЦелоеЧисло;
			НоваяСтрока.ФорматДанных = ?(
				Реквизит.КвалификаторыЧисла_Длина <= 9, ТипыЗначений.ЦелоеЧисло32, ТипыЗначений.ЦелоеЧисло64);
		Иначе
			НоваяСтрока.ТипДанных = ТипыЗначений.Число;
			НоваяСтрока.ФорматДанных = ?(Реквизит.КвалификаторыЧисла_Длина <= 7,
				ТипыЗначений.ДробноеЧисло, ТипыЗначений.ДробноеДвойнойТочности);
		КонецЕсли;

	ИначеЕсли Реквизит.ТипТипа = Перечисления.ТипыОбъектов.Булево Тогда
		НоваяСтрока.ТипДанных = ТипыЗначений.Логический;

	ИначеЕсли Реквизит.ТипТипа = Перечисления.ТипыОбъектов.Дата Тогда
		НоваяСтрока.ТипДанных = ТипыЗначений.Строка;
		Состав = НРег(СокрЛП(Реквизит.КвалификаторыДаты_Состав));
		Если Состав = "дата" Тогда
			НоваяСтрока.ФорматДанных = ТипыЗначений.Дата;
		ИначеЕсли Состав = "время" Тогда
			НоваяСтрока.ФорматДанных = ТипыЗначений.Время;
		Иначе
			НоваяСтрока.ФорматДанных = ТипыЗначений.ДатаВремя;
		КонецЕсли;

	ИначеЕсли Реквизит.ТипТипа = Перечисления.ТипыОбъектов.ХранилищеЗначения Тогда
		НоваяСтрока.ТипДанных = ТипыЗначений.Строка;
		НоваяСтрока.ФорматДанных = ТипыЗначений.ДанныеBase64;

	ИначеЕсли Реквизит.ТипТипа = Перечисления.ТипыОбъектов.УникальныйИдентификатор Тогда
		НоваяСтрока.ТипДанных = ТипыЗначений.Строка;
		НоваяСтрока.ФорматДанных = ТипыЗначений.УникальныйИдентификатор;

	ИначеЕсли Реквизит.ТипТипа = Перечисления.ТипыОбъектов.Перечисление Тогда
		НоваяСтрока.ТипДанных = ТипыЗначений.Строка;
		НоваяСтрока.Перечисление = ?(
			ЗначениеЗаполнено(Реквизит.Тип), ПеречисленияСпецификации.Получить(Реквизит.Тип), Неопределено);

	Иначе
		НоваяСтрока.ТипДанных = ТипыЗначений.Строка;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ИменаСпецификаций

Функция РазложитьШаблон(Знач ИсходныйШаблон)

	Результат = Новый Массив;
	Вхождения = СтрНайтиВсеПоРегулярномуВыражению(
		ИсходныйШаблон, "%(ТИП|ОПЕРАЦИЯ)(:(аа)([-_.]?)(аа)?)?%", Истина);

	Если Вхождения.Количество() = 0 Тогда
		Результат.Добавить(ИсходныйШаблон);
		Возврат Результат;
	КонецЕсли;

	ТекущаяПозиция = 1;
	Для Каждого Вхождение Из Вхождения Цикл

		ДлинаЗначения = Вхождение.НачальнаяПозиция - ТекущаяПозиция;
		Если ДлинаЗначения > 0 Тогда
			Результат.Добавить(Сред(ИсходныйШаблон, ТекущаяПозиция, ДлинаЗначения));
		КонецЕсли;

		Группы = Вхождение.ПолучитьГруппы();
		Выражение = Новый Структура;
		Выражение.Вставить("Ключ", Группы[0].Значение);
		Выражение.Вставить("РегистрПервогоСлова", "");
		Выражение.Вставить("Разделитель", "");
		Выражение.Вставить("РегистрСледующихСлов", "");
		Если Не (Группы[1] = Неопределено Или ПустаяСтрока(Группы[1].Значение)) Тогда
			Выражение.РегистрПервогоСлова = Группы[2].Значение;
			Выражение.Разделитель = Группы[3].Значение;
			Выражение.РегистрСледующихСлов = Группы[4].Значение;
		КонецЕсли;
		Результат.Добавить(Выражение);

		ТекущаяПозиция = Вхождение.НачальнаяПозиция + Вхождение.Длина;

	КонецЦикла;

	Если ТекущаяПозиция <= СтрДлина(ИсходныйШаблон) Тогда
		Результат.Добавить(Сред(ИсходныйШаблон, ТекущаяПозиция));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция РазложитьИмяТипаВМассивСлов(Знач ИмяТипа)

	Результат = Новый Массив;
	Если ПустаяСтрока(ИмяТипа) Тогда
		Возврат Результат;
	КонецЕсли;

	Слово = "";
	ДлинаИмени = СтрДлина(ИмяТипа);
	Для Позиция = 1 По ДлинаИмени Цикл

		Символ = Сред(ИмяТипа, Позиция, 1);
		Если СтрНайти("-_ .", Символ) > 0 Тогда
			Если Не ПустаяСтрока(Слово) Тогда
				Результат.Добавить(Слово);
				Слово = "";
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		НачалоНовогоСлова = Ложь;
		Если Не ПустаяСтрока(Слово) Тогда
			ПредыдущийСимвол = Сред(ИмяТипа, Позиция - 1, 1);
			ТекущаяПрописная = Символ = ВРег(Символ) И Символ <> НРег(Символ);
			ПредыдущаяСтрочная = ПредыдущийСимвол = НРег(ПредыдущийСимвол)
				И ПредыдущийСимвол <> ВРег(ПредыдущийСимвол);
			НачалоНовогоСлова = ТекущаяПрописная И ПредыдущаяСтрочная;

			Если Не НачалоНовогоСлова И ТекущаяПрописная И Позиция < ДлинаИмени Тогда
				СледующийСимвол = Сред(ИмяТипа, Позиция + 1, 1);
				ПредыдущаяПрописная = ПредыдущийСимвол = ВРег(ПредыдущийСимвол)
					И ПредыдущийСимвол <> НРег(ПредыдущийСимвол);
				СледующаяСтрочная = СледующийСимвол = НРег(СледующийСимвол)
					И СледующийСимвол <> ВРег(СледующийСимвол);
				НачалоНовогоСлова = ПредыдущаяПрописная И СледующаяСтрочная;
			КонецЕсли;
		КонецЕсли;

		Если НачалоНовогоСлова Тогда
			Результат.Добавить(Слово);
			Слово = "";
		КонецЕсли;
		Слово = Слово + Символ;

	КонецЦикла;

	Если Не ПустаяСтрока(Слово) Тогда
		Результат.Добавить(Слово);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СтрФормат(Значение, РегистрСлова)

	Если ПустаяСтрока(Значение) Или ПустаяСтрока(РегистрСлова) Тогда
		Возврат Значение;
	ИначеЕсли РегистрСлова = "АА" Тогда
		Возврат ВРег(Значение);
	ИначеЕсли РегистрСлова = "аа" Тогда
		Возврат НРег(Значение);
	ИначеЕсли РегистрСлова = "Аа" Тогда
		Возврат ТРег(Значение);
	ИначеЕсли РегистрСлова = "аА" Тогда
		Возврат НРег(Лев(Значение, 1)) + ВРег(Сред(Значение, 2));
	Иначе
		Возврат Значение;
	КонецЕсли;

КонецФункции

Функция СодержитТолькоДопустимыеСимволы(Значение)

	ДопустимыеСимволы = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-";
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти(ДопустимыеСимволы, Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ПроверкаСпецификаций

#Область ПолучениеДанных

Функция ПолучитьДанныеПроверки(Спецификация)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Спецификации.Ссылка КАК Ссылка,
		|	Спецификации.Владелец КАК Владелец,
		|	Спецификации.АдресТопика КАК АдресТопика,
		|	Спецификации.ИмяКанала КАК ИмяКанала,
		|	Спецификации.ИмяОперации КАК ИмяОперации,
		|	Спецификации.ИмяСообщения КАК ИмяСообщения,
		|	Спецификации.ИмяСообщенияКанала КАК ИмяСообщенияКанала,
		|	Спецификации.ИмяСхемы КАК ИмяСхемы
		|ИЗ
		|	Справочник.кфкСпецификации КАК Спецификации
		|ГДЕ
		|	Спецификации.Ссылка = &Спецификация
		|	И Спецификации.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТипыДанных.Ссылка КАК Ссылка,
		|	ТипыДанных.Родитель КАК Родитель,
		|	ТипыДанных.Код КАК Код
		|ИЗ
		|	Справочник.кфкТипыДанныхСпецификации КАК ТипыДанных
		|ГДЕ
		|	ТипыДанных.Владелец = &Спецификация
		|	И ТипыДанных.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	ТипыДанных.Родитель,
		|	ТипыДанных.Код,
		|	ТипыДанных.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Перечисления.Ссылка КАК Ссылка,
		|	Перечисления.Наименование КАК Наименование
		|ИЗ
		|	Справочник.кфкПеречисленияСпецификации КАК Перечисления
		|ГДЕ
		|	Перечисления.Владелец = &Спецификация
		|	И Перечисления.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Перечисления.Наименование,
		|	Перечисления.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Каналы.Ссылка КАК Ссылка,
		|	Каналы.Наименование КАК Наименование,
		|	Каналы.Отправитель КАК Отправитель,
		|	Каналы.ТипДанных КАК ТипДанных,
		|	ТипыДанных.Код КАК КодТипаДанных,
		|	ТипыДанных.ПометкаУдаления КАК ТипДанныхПометкаУдаления,
		|	Каналы.АдресТопика КАК АдресТопика,
		|	Каналы.ИмяКанала КАК ИмяКанала,
		|	Каналы.ИмяОперации КАК ИмяОперации,
		|	Каналы.ИмяСообщения КАК ИмяСообщения,
		|	Каналы.ИмяСообщенияКанала КАК ИмяСообщенияКанала
		|ИЗ
		|	Справочник.кфкКаналыСпецификации КАК Каналы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.кфкТипыДанныхСпецификации КАК ТипыДанных
		|		ПО Каналы.ТипДанных = ТипыДанных.Ссылка
		|ГДЕ
		|	Каналы.Владелец = &Спецификация
		|	И Каналы.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Каналы.Наименование,
		|	Каналы.Ссылка";
	Запрос.УстановитьПараметр("Спецификация", Спецификация);
	Результаты = Запрос.ВыполнитьПакет();

	Спецификации = Результаты[0].Выгрузить();
	Если Спецификации.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Спецификация не найдена или помечена на удаление.'");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Спецификация", Спецификации[0]);
	Результат.Вставить("ТипыДанных", Результаты[1].Выгрузить());
	Результат.Вставить("Перечисления", Результаты[2].Выгрузить());
	Результат.Вставить("Каналы", Результаты[3].Выгрузить());

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ОбщиеПравила

Процедура ПроверитьШаблоны(Данные, Ошибки)

	ПоляШаблонов = ПоляШаблонов();
	Для Каждого ИмяПоля Из ПоляШаблонов Цикл
		ПроверитьОдинШаблон(
			Данные.Спецификация[ИмяПоля], Данные.Спецификация.Ссылка, ИмяПоля, Ошибки);
	КонецЦикла;

	Для Каждого Канал Из Данные.Каналы Цикл
		Для Каждого ИмяПоля Из ПоляШаблонов Цикл
			Если ИмяПоля = "ИмяСхемы" Тогда
				Продолжить;
			КонецЕсли;
			Если ПустаяСтрока(Канал[ИмяПоля]) Тогда
				Продолжить;
			КонецЕсли;
			ПроверитьОдинШаблон(Канал[ИмяПоля], Канал.Ссылка, ИмяПоля, Ошибки);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОдинШаблон(Шаблон, Объект, ИмяПоля, Ошибки)

	ТекстОшибки = ПроверитьШаблон(Шаблон);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ДобавитьОшибку(Ошибки, "KFK-TEMPLATE-001", Объект, ИмяПоля,
			ТекстОшибкиЗначения(Шаблон, ТекстОшибки));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКодыТиповДанных(Данные, Ошибки)

	Для Каждого ТипДанных Из Данные.ТипыДанных Цикл
		ТекстОшибки = ПроверитьТехническийИдентификатор(ТипДанных.Код);
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
			ДобавитьОшибку(Ошибки, "KFK-TYPE-CODE-001", ТипДанных.Ссылка, "Код",
				ТекстОшибкиЗначения(ТипДанных.Код, ТекстОшибки));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьИменаПеречислений(Данные, Ошибки)

	Для Каждого Перечисление Из Данные.Перечисления Цикл
		ТекстОшибки = ПроверитьТехническийИдентификатор(Перечисление.Наименование);
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
			ДобавитьОшибку(Ошибки, "KFK-ENUM-NAME-001", Перечисление.Ссылка, "Наименование",
				ТекстОшибкиЗначения(Перечисление.Наименование, ТекстОшибки));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ФормированиеОшибок

Функция ПоляШаблонов()
	Возврат СтрРазделить(
		"АдресТопика,ИмяКанала,ИмяОперации,ИмяСообщения,ИмяСообщенияКанала,ИмяСхемы", ",");
КонецФункции

Функция ТекстОшибкиЗначения(Значение, ТекстОшибки)

	Если Значение = Неопределено Или ПустаяСтрока(Значение) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Текущее значение: ""%1"". %2'"), Значение, ТекстОшибки);

КонецФункции

Процедура ДобавитьОшибку(Ошибки, КодПравила, Объект, ИмяПоля, ТекстОшибки)

	Ошибка = Новый Структура;
	Ошибка.Вставить("КодПравила", КодПравила);
	Ошибка.Вставить("Объект", Объект);
	Ошибка.Вставить("ИмяПоля", ИмяПоля);
	Ошибка.Вставить("ТекстОшибки", ТекстОшибки);
	Ошибки.Добавить(Ошибка);

КонецПроцедуры

#КонецОбласти

#Область ПравилаКаналов

Процедура ПроверитьКаналыИКоллизии(Данные, Ошибки)

	КлючиКаналов = Новый Соответствие;
	КлючиОпераций = Новый Соответствие;
	КлючиСообщений = Новый Соответствие;
	КлючиСхем = Новый Соответствие;

	ПроверитьКлючиСхем(Данные, КлючиСхем, Ошибки);
	Для Каждого Канал Из Данные.Каналы Цикл

		Если Канал.ТипДанных.Пустая() Или Канал.ТипДанныхПометкаУдаления Тогда
			ДобавитьОшибку(Ошибки, "KFK-CHANNEL-TYPE-001", Канал.Ссылка, "ТипДанных",
				НСтр("ru = 'Не задан активный тип данных канала.'"));
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(Канал.КодТипаДанных) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(
				ПроверитьТехническийИдентификатор(Канал.КодТипаДанных)) Тогда
			Продолжить;
		КонецЕсли;

		ШаблонТопика = ШаблонКанала(Данные.Спецификация, Канал, "АдресТопика");
		ШаблонИмениКанала = ШаблонКанала(Данные.Спецификация, Канал, "ИмяКанала");
		ШаблонОперации = ШаблонКанала(Данные.Спецификация, Канал, "ИмяОперации");
		ШаблонСообщения = ШаблонКанала(Данные.Спецификация, Канал, "ИмяСообщения");
		ШаблонСообщенияКанала = ШаблонКанала(
			Данные.Спецификация, Канал, "ИмяСообщенияКанала");

		Операция = ?(Данные.Спецификация.Владелец = Канал.Отправитель, "send", "receive");
		АдресТопика = СформироватьИмя(ШаблонТопика, Канал.КодТипаДанных);
		ИмяКанала = СформироватьИмя(ШаблонИмениКанала, Канал.КодТипаДанных);
		ИмяОперации = СформироватьИмя(ШаблонОперации, Канал.КодТипаДанных, Операция);
		ИмяСообщения = СформироватьИмя(ШаблонСообщения, Канал.КодТипаДанных);
		ИмяСообщенияКанала = СформироватьИмя(ШаблонСообщенияКанала, Канал.КодТипаДанных);

		ПроверитьТопик(АдресТопика, Канал.Ссылка, Ошибки);
		ПроверитьИДобавитьКлюч(ИмяКанала, Канал.Ссылка, "ИмяКанала",
			"KFK-CHANNEL-NAME-001", "KFK-CHANNEL-COLLISION-001", КлючиКаналов, Ошибки);
		ПроверитьИДобавитьКлюч(ИмяОперации, Канал.Ссылка, "ИмяОперации",
			"KFK-OPERATION-NAME-001", "KFK-OPERATION-COLLISION-001", КлючиОпераций, Ошибки);
		ПроверитьИДобавитьКлюч(ИмяСообщения, Канал.Ссылка, "ИмяСообщения",
			"KFK-MESSAGE-NAME-001", "KFK-MESSAGE-COLLISION-001", КлючиСообщений, Ошибки);
		ПроверитьИдентификатор(ИмяСообщенияКанала, Канал.Ссылка,
			"ИмяСообщенияКанала", "KFK-CHANNEL-MESSAGE-NAME-001", Ошибки);

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьКлючиСхем(Данные, КлючиСхем, Ошибки)

	Для Каждого ТипДанных Из Данные.ТипыДанных Цикл
		Если Не ТипДанных.Родитель.Пустая() Или ПустаяСтрока(ТипДанных.Код) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(
				ПроверитьТехническийИдентификатор(ТипДанных.Код)) Тогда
			Продолжить;
		КонецЕсли;

		ИмяСхемы = СформироватьИмя(Данные.Спецификация.ИмяСхемы, ТипДанных.Код);
		ПроверитьИДобавитьКлюч(ИмяСхемы, ТипДанных.Ссылка, "Код",
			"KFK-SCHEMA-NAME-001", "KFK-SCHEMA-COLLISION-001", КлючиСхем, Ошибки);
	КонецЦикла;

	Для Каждого Перечисление Из Данные.Перечисления Цикл
		Если Не ПустаяСтрока(ПроверитьТехническийИдентификатор(
				Перечисление.Наименование)) Тогда
			Продолжить;
		КонецЕсли;
		ПроверитьИДобавитьКлюч(Перечисление.Наименование, Перечисление.Ссылка, "Наименование",
			"KFK-SCHEMA-NAME-001", "KFK-SCHEMA-COLLISION-001", КлючиСхем, Ошибки);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьТопик(АдресТопика, Объект, Ошибки)

	Если АдресТопика = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстОшибки = ПроверитьАдресТопика(АдресТопика);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ДобавитьОшибку(Ошибки, "KFK-TOPIC-001", Объект, "АдресТопика",
			ТекстОшибкиЗначения(АдресТопика, ТекстОшибки));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИДобавитьКлюч(
		Ключ, Объект, ИмяПоля, КодИмени, КодКоллизии, КоллекцияКлючей, Ошибки)

	Если Не ПроверитьИдентификатор(Ключ, Объект, ИмяПоля, КодИмени, Ошибки) Тогда
		Возврат;
	КонецЕсли;

	СуществующийОбъект = КоллекцияКлючей.Получить(Ключ);
	Если СуществующийОбъект = Неопределено Тогда
		КоллекцияКлючей.Вставить(Ключ, Объект);
	Иначе
		ДобавитьОшибку(Ошибки, КодКоллизии, Объект, ИмяПоля,
			СтрШаблон(
				НСтр("ru = 'Сформированное имя ""%1"" уже используется объектом ""%2"". Измените шаблон или исходное имя.'"),
				Ключ, СуществующийОбъект));
	КонецЕсли;

КонецПроцедуры

Функция ПроверитьИдентификатор(Ключ, Объект, ИмяПоля, КодПравила, Ошибки)

	Если Ключ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекстОшибки = ПроверитьТехническийИдентификатор(Ключ);
	Если ПустаяСтрока(ТекстОшибки) Тогда
		Возврат Истина;
	КонецЕсли;

	ДобавитьОшибку(Ошибки, КодПравила, Объект, ИмяПоля,
		ТекстОшибкиЗначения(Ключ, ТекстОшибки));
	Возврат Ложь;

КонецФункции

Функция ШаблонКанала(Спецификация, Канал, ИмяПоля)
	Возврат ?(ПустаяСтрока(Канал[ИмяПоля]), Спецификация[ИмяПоля], Канал[ИмяПоля]);
КонецФункции

#КонецОбласти

